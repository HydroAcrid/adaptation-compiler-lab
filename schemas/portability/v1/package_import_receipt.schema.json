{
  "$defs": {
    "ShareablePackageType": {
      "enum": [
        "behavior_pack",
        "capability_mode",
        "personal_mode_overlay"
      ],
      "title": "ShareablePackageType",
      "type": "string"
    },
    "SignatureEnvelope": {
      "additionalProperties": false,
      "description": "Detached Ed25519 signature metadata included in a signed object.",
      "properties": {
        "algorithm": {
          "const": "Ed25519",
          "default": "Ed25519",
          "title": "Algorithm",
          "type": "string"
        },
        "canonicalization_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Canonicalization Version",
          "type": "string"
        },
        "key_fingerprint": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Key Fingerprint",
          "type": "string"
        },
        "purpose": {
          "minLength": 1,
          "title": "Purpose",
          "type": "string"
        },
        "signature_base64": {
          "minLength": 1,
          "title": "Signature Base64",
          "type": "string"
        },
        "signed_at": {
          "format": "date-time",
          "title": "Signed At",
          "type": "string"
        },
        "signer_identity_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Signer Identity Id",
          "type": "string"
        }
      },
      "required": [
        "signer_identity_id",
        "key_fingerprint",
        "purpose",
        "signed_at",
        "signature_base64"
      ],
      "title": "SignatureEnvelope",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "activates_artifacts": {
      "const": false,
      "default": false,
      "title": "Activates Artifacts",
      "type": "boolean"
    },
    "conflicting_item_ids": {
      "default": [],
      "items": {
        "maxLength": 200,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
        "type": "string"
      },
      "title": "Conflicting Item Ids",
      "type": "array"
    },
    "duplicate_item_ids": {
      "default": [],
      "items": {
        "maxLength": 200,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
        "type": "string"
      },
      "title": "Duplicate Item Ids",
      "type": "array"
    },
    "grants_user_authority": {
      "const": false,
      "default": false,
      "title": "Grants User Authority",
      "type": "boolean"
    },
    "idempotency_key_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Idempotency Key Digest",
      "type": "string"
    },
    "imported_at": {
      "format": "date-time",
      "title": "Imported At",
      "type": "string"
    },
    "local_public_key_base64": {
      "minLength": 1,
      "title": "Local Public Key Base64",
      "type": "string"
    },
    "local_signer_identity_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Local Signer Identity Id",
      "type": "string"
    },
    "local_signer_key_fingerprint": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Local Signer Key Fingerprint",
      "type": "string"
    },
    "local_subject_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Local Subject Id",
      "type": "string"
    },
    "package_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Package Digest",
      "type": "string"
    },
    "package_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Package Id",
      "type": "string"
    },
    "package_type": {
      "$ref": "#/$defs/ShareablePackageType"
    },
    "publisher_key_fingerprint": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Publisher Key Fingerprint",
      "type": "string"
    },
    "receipt_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Receipt Id",
      "type": "string"
    },
    "receipt_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Receipt Version",
      "type": "string"
    },
    "release_version": {
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$",
      "title": "Release Version",
      "type": "string"
    },
    "signature": {
      "$ref": "#/$defs/SignatureEnvelope"
    },
    "status": {
      "const": "staged_inactive_for_review",
      "default": "staged_inactive_for_review",
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "receipt_id",
    "package_type",
    "package_id",
    "release_version",
    "package_digest",
    "publisher_key_fingerprint",
    "local_subject_id",
    "local_signer_identity_id",
    "local_public_key_base64",
    "local_signer_key_fingerprint",
    "imported_at",
    "idempotency_key_digest",
    "signature"
  ],
  "title": "PackageImportReceiptV1",
  "type": "object"
}
