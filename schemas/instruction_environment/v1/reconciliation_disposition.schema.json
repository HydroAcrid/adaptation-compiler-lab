{
  "$defs": {
    "ReconciliationDispositionKind": {
      "description": "The least-invasive deterministic treatment of one Temper clause.",
      "enum": [
        "included",
        "omitted_as_covered",
        "blocked_by_policy",
        "included_with_native_memory_conflict",
        "preserved_as_scoped_exception",
        "needs_review"
      ],
      "title": "ReconciliationDispositionKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Authority-aware disposition for one approved Temper clause.",
  "properties": {
    "delivery_blocked": {
      "title": "Delivery Blocked",
      "type": "boolean"
    },
    "disposition": {
      "$ref": "#/$defs/ReconciliationDispositionKind"
    },
    "disposition_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Disposition Version",
      "type": "string"
    },
    "native_change_required": {
      "const": false,
      "default": false,
      "title": "Native Change Required",
      "type": "boolean"
    },
    "native_clause_ids": {
      "default": [],
      "items": {
        "maxLength": 200,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
        "type": "string"
      },
      "title": "Native Clause Ids",
      "type": "array"
    },
    "native_source_ids": {
      "default": [],
      "items": {
        "maxLength": 200,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
        "type": "string"
      },
      "title": "Native Source Ids",
      "type": "array"
    },
    "rationale": {
      "minLength": 1,
      "title": "Rationale",
      "type": "string"
    },
    "review_required": {
      "default": false,
      "title": "Review Required",
      "type": "boolean"
    },
    "temper_clause_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Temper Clause Digest",
      "type": "string"
    }
  },
  "required": [
    "temper_clause_digest",
    "disposition",
    "rationale",
    "delivery_blocked"
  ],
  "title": "ReconciliationDispositionV1",
  "type": "object"
}
