{
  "$defs": {
    "BenchmarkRegistrationRef": {
      "additionalProperties": false,
      "properties": {
        "content_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Digest",
          "type": "string"
        },
        "governance_type": {
          "const": "benchmark_registration",
          "default": "benchmark_registration",
          "title": "Governance Type",
          "type": "string"
        },
        "object_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Object Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "object_id",
        "content_digest"
      ],
      "title": "BenchmarkRegistrationRef",
      "type": "object"
    },
    "ConditionMaterialReceiptRef": {
      "additionalProperties": false,
      "properties": {
        "content_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Digest",
          "type": "string"
        },
        "governance_type": {
          "const": "condition_material_receipt",
          "default": "condition_material_receipt",
          "title": "Governance Type",
          "type": "string"
        },
        "object_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Object Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "object_id",
        "content_digest"
      ],
      "title": "ConditionMaterialReceiptRef",
      "type": "object"
    },
    "SignatureEnvelope": {
      "additionalProperties": false,
      "description": "Detached Ed25519 signature metadata included in a signed object.",
      "properties": {
        "algorithm": {
          "const": "Ed25519",
          "default": "Ed25519",
          "title": "Algorithm",
          "type": "string"
        },
        "canonicalization_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Canonicalization Version",
          "type": "string"
        },
        "key_fingerprint": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Key Fingerprint",
          "type": "string"
        },
        "purpose": {
          "minLength": 1,
          "title": "Purpose",
          "type": "string"
        },
        "signature_base64": {
          "minLength": 1,
          "title": "Signature Base64",
          "type": "string"
        },
        "signed_at": {
          "format": "date-time",
          "title": "Signed At",
          "type": "string"
        },
        "signer_identity_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Signer Identity Id",
          "type": "string"
        }
      },
      "required": [
        "signer_identity_id",
        "key_fingerprint",
        "purpose",
        "signed_at",
        "signature_base64"
      ],
      "title": "SignatureEnvelope",
      "type": "object"
    },
    "TrialValidity": {
      "enum": [
        "valid",
        "invalid"
      ],
      "title": "TrialValidity",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Immutable blinded scoring result; later corrections require adjudication.",
  "properties": {
    "automated_correctness": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Automated Correctness",
      "type": "number"
    },
    "automated_test_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Automated Test Digest",
      "type": "string"
    },
    "benchmark_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Benchmark Id",
      "type": "string"
    },
    "blind_condition_id": {
      "pattern": "^cond-[0-9a-f]{12,64}$",
      "title": "Blind Condition Id",
      "type": "string"
    },
    "blind_task_id": {
      "pattern": "^task-[0-9a-f]{12,64}$",
      "title": "Blind Task Id",
      "type": "string"
    },
    "change_discipline": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Change Discipline",
      "type": "number"
    },
    "condition_material_ref": {
      "$ref": "#/$defs/ConditionMaterialReceiptRef"
    },
    "environment_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Environment Digest",
      "type": "string"
    },
    "governance_type": {
      "const": "trial_result",
      "default": "trial_result",
      "title": "Governance Type",
      "type": "string"
    },
    "guardrail_codes": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Guardrail Codes",
      "type": "array"
    },
    "invalid_reason": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Invalid Reason"
    },
    "policy_version": {
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$",
      "title": "Policy Version",
      "type": "string"
    },
    "registration_ref": {
      "$ref": "#/$defs/BenchmarkRegistrationRef"
    },
    "repetition": {
      "maximum": 2,
      "minimum": 1,
      "title": "Repetition",
      "type": "integer"
    },
    "requirement_coverage": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Requirement Coverage",
      "type": "number"
    },
    "result_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Result Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scored_at": {
      "format": "date-time",
      "title": "Scored At",
      "type": "string"
    },
    "scorer_identity": {
      "minLength": 1,
      "title": "Scorer Identity",
      "type": "string"
    },
    "signature": {
      "$ref": "#/$defs/SignatureEnvelope"
    },
    "subject_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Subject Id",
      "type": "string"
    },
    "task_rubric_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Task Rubric Digest",
      "type": "string"
    },
    "trial_record_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Trial Record Digest",
      "type": "string"
    },
    "validity": {
      "$ref": "#/$defs/TrialValidity"
    }
  },
  "required": [
    "result_id",
    "subject_id",
    "benchmark_id",
    "registration_ref",
    "condition_material_ref",
    "blind_task_id",
    "blind_condition_id",
    "repetition",
    "trial_record_digest",
    "environment_digest",
    "task_rubric_digest",
    "automated_test_digest",
    "automated_correctness",
    "requirement_coverage",
    "change_discipline",
    "validity",
    "scorer_identity",
    "scored_at",
    "policy_version",
    "signature"
  ],
  "title": "TrialResult",
  "type": "object"
}
