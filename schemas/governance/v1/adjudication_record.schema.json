{
  "$defs": {
    "AdjudicatedField": {
      "enum": [
        "validity",
        "automated_correctness",
        "requirement_coverage",
        "change_discipline",
        "guardrails"
      ],
      "title": "AdjudicatedField",
      "type": "string"
    },
    "AdjudicatedValue": {
      "additionalProperties": false,
      "description": "Digest-only correction; original and corrected private values stay outside metadata.",
      "properties": {
        "corrected_value_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Corrected Value Digest",
          "type": "string"
        },
        "field_name": {
          "$ref": "#/$defs/AdjudicatedField"
        },
        "original_value_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Original Value Digest",
          "type": "string"
        }
      },
      "required": [
        "field_name",
        "original_value_digest",
        "corrected_value_digest"
      ],
      "title": "AdjudicatedValue",
      "type": "object"
    },
    "AdjudicationDecision": {
      "enum": [
        "uphold",
        "annotate",
        "exclude_from_analysis",
        "correct_derived_value"
      ],
      "title": "AdjudicationDecision",
      "type": "string"
    },
    "AdjudicationRecordRef": {
      "additionalProperties": false,
      "properties": {
        "content_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Digest",
          "type": "string"
        },
        "governance_type": {
          "const": "adjudication_record",
          "default": "adjudication_record",
          "title": "Governance Type",
          "type": "string"
        },
        "object_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Object Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "object_id",
        "content_digest"
      ],
      "title": "AdjudicationRecordRef",
      "type": "object"
    },
    "SignatureEnvelope": {
      "additionalProperties": false,
      "description": "Detached Ed25519 signature metadata included in a signed object.",
      "properties": {
        "algorithm": {
          "const": "Ed25519",
          "default": "Ed25519",
          "title": "Algorithm",
          "type": "string"
        },
        "canonicalization_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Canonicalization Version",
          "type": "string"
        },
        "key_fingerprint": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Key Fingerprint",
          "type": "string"
        },
        "purpose": {
          "minLength": 1,
          "title": "Purpose",
          "type": "string"
        },
        "signature_base64": {
          "minLength": 1,
          "title": "Signature Base64",
          "type": "string"
        },
        "signed_at": {
          "format": "date-time",
          "title": "Signed At",
          "type": "string"
        },
        "signer_identity_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Signer Identity Id",
          "type": "string"
        }
      },
      "required": [
        "signer_identity_id",
        "key_fingerprint",
        "purpose",
        "signed_at",
        "signature_base64"
      ],
      "title": "SignatureEnvelope",
      "type": "object"
    },
    "TrialResultRef": {
      "additionalProperties": false,
      "properties": {
        "content_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Digest",
          "type": "string"
        },
        "governance_type": {
          "const": "trial_result",
          "default": "trial_result",
          "title": "Governance Type",
          "type": "string"
        },
        "object_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Object Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "object_id",
        "content_digest"
      ],
      "title": "TrialResultRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Append-only correction linked to an immutable TrialResult.",
  "properties": {
    "adjudicated_at": {
      "format": "date-time",
      "title": "Adjudicated At",
      "type": "string"
    },
    "adjudication_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Adjudication Id",
      "type": "string"
    },
    "benchmark_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Benchmark Id",
      "type": "string"
    },
    "changes": {
      "default": [],
      "items": {
        "$ref": "#/$defs/AdjudicatedValue"
      },
      "title": "Changes",
      "type": "array"
    },
    "decision": {
      "$ref": "#/$defs/AdjudicationDecision"
    },
    "governance_type": {
      "const": "adjudication_record",
      "default": "adjudication_record",
      "title": "Governance Type",
      "type": "string"
    },
    "policy_version": {
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$",
      "title": "Policy Version",
      "type": "string"
    },
    "previous_adjudication_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/AdjudicationRecordRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "reason": {
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "reviewer_identity": {
      "minLength": 1,
      "title": "Reviewer Identity",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "sequence": {
      "exclusiveMinimum": 0,
      "title": "Sequence",
      "type": "integer"
    },
    "signature": {
      "$ref": "#/$defs/SignatureEnvelope"
    },
    "subject_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Subject Id",
      "type": "string"
    },
    "trial_result_ref": {
      "$ref": "#/$defs/TrialResultRef"
    }
  },
  "required": [
    "adjudication_id",
    "subject_id",
    "benchmark_id",
    "trial_result_ref",
    "sequence",
    "decision",
    "reason",
    "reviewer_identity",
    "adjudicated_at",
    "policy_version",
    "signature"
  ],
  "title": "AdjudicationRecord",
  "type": "object"
}
