{
  "$defs": {
    "DependencyImpactRef": {
      "additionalProperties": false,
      "properties": {
        "content_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Digest",
          "type": "string"
        },
        "governance_type": {
          "const": "dependency_impact",
          "default": "dependency_impact",
          "title": "Governance Type",
          "type": "string"
        },
        "object_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Object Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "object_id",
        "content_digest"
      ],
      "title": "DependencyImpactRef",
      "type": "object"
    },
    "InvalidationEventRef": {
      "additionalProperties": false,
      "properties": {
        "content_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Digest",
          "type": "string"
        },
        "governance_type": {
          "const": "invalidation_event",
          "default": "invalidation_event",
          "title": "Governance Type",
          "type": "string"
        },
        "object_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Object Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "object_id",
        "content_digest"
      ],
      "title": "InvalidationEventRef",
      "type": "object"
    },
    "SignatureEnvelope": {
      "additionalProperties": false,
      "description": "Detached Ed25519 signature metadata included in a signed object.",
      "properties": {
        "algorithm": {
          "const": "Ed25519",
          "default": "Ed25519",
          "title": "Algorithm",
          "type": "string"
        },
        "canonicalization_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Canonicalization Version",
          "type": "string"
        },
        "key_fingerprint": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Key Fingerprint",
          "type": "string"
        },
        "purpose": {
          "minLength": 1,
          "title": "Purpose",
          "type": "string"
        },
        "signature_base64": {
          "minLength": 1,
          "title": "Signature Base64",
          "type": "string"
        },
        "signed_at": {
          "format": "date-time",
          "title": "Signed At",
          "type": "string"
        },
        "signer_identity_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Signer Identity Id",
          "type": "string"
        }
      },
      "required": [
        "signer_identity_id",
        "key_fingerprint",
        "purpose",
        "signed_at",
        "signature_base64"
      ],
      "title": "SignatureEnvelope",
      "type": "object"
    },
    "TombstoneReceiptRef": {
      "additionalProperties": false,
      "properties": {
        "content_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Digest",
          "type": "string"
        },
        "governance_type": {
          "const": "tombstone_receipt",
          "default": "tombstone_receipt",
          "title": "Governance Type",
          "type": "string"
        },
        "object_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Object Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "object_id",
        "content_digest"
      ],
      "title": "TombstoneReceiptRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Signed completion record for one confirmed dependency impact.",
  "properties": {
    "completed_at": {
      "format": "date-time",
      "title": "Completed At",
      "type": "string"
    },
    "deactivated_environment_ids": {
      "default": [],
      "items": {
        "maxLength": 200,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
        "type": "string"
      },
      "title": "Deactivated Environment Ids",
      "type": "array"
    },
    "dependency_impact_ref": {
      "$ref": "#/$defs/DependencyImpactRef"
    },
    "governance_type": {
      "const": "recall_report",
      "default": "recall_report",
      "title": "Governance Type",
      "type": "string"
    },
    "invalidation_refs": {
      "items": {
        "$ref": "#/$defs/InvalidationEventRef"
      },
      "minItems": 1,
      "title": "Invalidation Refs",
      "type": "array"
    },
    "policy_version": {
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$",
      "title": "Policy Version",
      "type": "string"
    },
    "purged_payload_digests": {
      "default": [],
      "items": {
        "pattern": "^sha256:[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Purged Payload Digests",
      "type": "array"
    },
    "report_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Report Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "signature": {
      "$ref": "#/$defs/SignatureEnvelope"
    },
    "status": {
      "const": "completed",
      "default": "completed",
      "title": "Status",
      "type": "string"
    },
    "subject_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Subject Id",
      "type": "string"
    },
    "tombstone_refs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/TombstoneReceiptRef"
      },
      "title": "Tombstone Refs",
      "type": "array"
    }
  },
  "required": [
    "report_id",
    "subject_id",
    "dependency_impact_ref",
    "invalidation_refs",
    "completed_at",
    "policy_version",
    "signature"
  ],
  "title": "RecallReport",
  "type": "object"
}
