{
  "$defs": {
    "DependencyImpactRef": {
      "additionalProperties": false,
      "properties": {
        "content_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Digest",
          "type": "string"
        },
        "governance_type": {
          "const": "dependency_impact",
          "default": "dependency_impact",
          "title": "Governance Type",
          "type": "string"
        },
        "object_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Object Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "object_id",
        "content_digest"
      ],
      "title": "DependencyImpactRef",
      "type": "object"
    },
    "InvalidationAction": {
      "enum": [
        "revoke_consent",
        "restrict_evidence",
        "purge_evidence",
        "revoke_artifact",
        "retire_release",
        "invalidate_target_pack",
        "exclude_dependency",
        "deactivate_activation"
      ],
      "title": "InvalidationAction",
      "type": "string"
    },
    "RecallTarget": {
      "additionalProperties": false,
      "description": "Exact governance, record-version, or activation-head target.",
      "properties": {
        "content_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Digest",
          "type": "string"
        },
        "object_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Object Id",
          "type": "string"
        },
        "record_version": {
          "anyOf": [
            {
              "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Record Version"
        },
        "target_kind": {
          "$ref": "#/$defs/RecallTargetKind"
        }
      },
      "required": [
        "target_kind",
        "object_id",
        "content_digest"
      ],
      "title": "RecallTarget",
      "type": "object"
    },
    "RecallTargetKind": {
      "enum": [
        "consent_receipt",
        "capture_receipt",
        "task_record",
        "outcome",
        "evidence",
        "evaluation_case",
        "lesson_candidate",
        "artifact",
        "release",
        "target_pack",
        "activation"
      ],
      "title": "RecallTargetKind",
      "type": "string"
    },
    "SignatureEnvelope": {
      "additionalProperties": false,
      "description": "Detached Ed25519 signature metadata included in a signed object.",
      "properties": {
        "algorithm": {
          "const": "Ed25519",
          "default": "Ed25519",
          "title": "Algorithm",
          "type": "string"
        },
        "canonicalization_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Canonicalization Version",
          "type": "string"
        },
        "key_fingerprint": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Key Fingerprint",
          "type": "string"
        },
        "purpose": {
          "minLength": 1,
          "title": "Purpose",
          "type": "string"
        },
        "signature_base64": {
          "minLength": 1,
          "title": "Signature Base64",
          "type": "string"
        },
        "signed_at": {
          "format": "date-time",
          "title": "Signed At",
          "type": "string"
        },
        "signer_identity_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Signer Identity Id",
          "type": "string"
        }
      },
      "required": [
        "signer_identity_id",
        "key_fingerprint",
        "purpose",
        "signed_at",
        "signature_base64"
      ],
      "title": "SignatureEnvelope",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Signed declaration that one exact target is no longer eligible for use.",
  "properties": {
    "action": {
      "$ref": "#/$defs/InvalidationAction"
    },
    "dependency_impact_ref": {
      "$ref": "#/$defs/DependencyImpactRef"
    },
    "effective_at": {
      "format": "date-time",
      "title": "Effective At",
      "type": "string"
    },
    "event_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Event Id",
      "type": "string"
    },
    "governance_type": {
      "const": "invalidation_event",
      "default": "invalidation_event",
      "title": "Governance Type",
      "type": "string"
    },
    "policy_version": {
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$",
      "title": "Policy Version",
      "type": "string"
    },
    "reason": {
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "signature": {
      "$ref": "#/$defs/SignatureEnvelope"
    },
    "subject_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Subject Id",
      "type": "string"
    },
    "target": {
      "$ref": "#/$defs/RecallTarget"
    }
  },
  "required": [
    "event_id",
    "subject_id",
    "action",
    "target",
    "dependency_impact_ref",
    "reason",
    "policy_version",
    "effective_at",
    "signature"
  ],
  "title": "InvalidationEvent",
  "type": "object"
}
