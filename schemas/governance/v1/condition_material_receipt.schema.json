{
  "$defs": {
    "BenchmarkCondition": {
      "description": "The four mandatory confirmatory conditions.",
      "enum": [
        "base",
        "ordinary_memory",
        "strong_static_profile",
        "compiled_adaptation"
      ],
      "title": "BenchmarkCondition",
      "type": "string"
    },
    "BenchmarkRegistrationRef": {
      "additionalProperties": false,
      "properties": {
        "content_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Digest",
          "type": "string"
        },
        "governance_type": {
          "const": "benchmark_registration",
          "default": "benchmark_registration",
          "title": "Governance Type",
          "type": "string"
        },
        "object_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Object Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "object_id",
        "content_digest"
      ],
      "title": "BenchmarkRegistrationRef",
      "type": "object"
    },
    "ConditionAuthorRole": {
      "enum": [
        "none",
        "deterministic_renderer",
        "independent_human",
        "isolated_ai",
        "compiler"
      ],
      "title": "ConditionAuthorRole",
      "type": "string"
    },
    "ConditionConstructionMethod": {
      "enum": [
        "none",
        "deterministic_approved_feedback",
        "independent_human_profile",
        "isolated_ai_two_pass_profile",
        "compiled_release_pack"
      ],
      "title": "ConditionConstructionMethod",
      "type": "string"
    },
    "SignatureEnvelope": {
      "additionalProperties": false,
      "description": "Detached Ed25519 signature metadata included in a signed object.",
      "properties": {
        "algorithm": {
          "const": "Ed25519",
          "default": "Ed25519",
          "title": "Algorithm",
          "type": "string"
        },
        "canonicalization_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Canonicalization Version",
          "type": "string"
        },
        "key_fingerprint": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Key Fingerprint",
          "type": "string"
        },
        "purpose": {
          "minLength": 1,
          "title": "Purpose",
          "type": "string"
        },
        "signature_base64": {
          "minLength": 1,
          "title": "Signature Base64",
          "type": "string"
        },
        "signed_at": {
          "format": "date-time",
          "title": "Signed At",
          "type": "string"
        },
        "signer_identity_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Signer Identity Id",
          "type": "string"
        }
      },
      "required": [
        "signer_identity_id",
        "key_fingerprint",
        "purpose",
        "signed_at",
        "signature_base64"
      ],
      "title": "SignatureEnvelope",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Signed frozen material metadata for exactly one benchmark condition.",
  "properties": {
    "author_context_id": {
      "anyOf": [
        {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Author Context Id"
    },
    "author_identity": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Author Identity"
    },
    "author_may_score_results": {
      "const": false,
      "default": false,
      "title": "Author May Score Results",
      "type": "boolean"
    },
    "author_packet_digest": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Author Packet Digest"
    },
    "author_role": {
      "$ref": "#/$defs/ConditionAuthorRole"
    },
    "authoring_minutes": {
      "maximum": 90,
      "minimum": 0,
      "title": "Authoring Minutes",
      "type": "integer"
    },
    "benchmark_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Benchmark Id",
      "type": "string"
    },
    "blind_condition_id": {
      "pattern": "^cond-[0-9a-f]{12,64}$",
      "title": "Blind Condition Id",
      "type": "string"
    },
    "bundle_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Bundle Digest",
      "type": "string"
    },
    "condition": {
      "$ref": "#/$defs/BenchmarkCondition"
    },
    "construction_method": {
      "$ref": "#/$defs/ConditionConstructionMethod"
    },
    "construction_started_at": {
      "format": "date-time",
      "title": "Construction Started At",
      "type": "string"
    },
    "eligible_corpus_digest": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Eligible Corpus Digest"
    },
    "frozen_at": {
      "format": "date-time",
      "title": "Frozen At",
      "type": "string"
    },
    "governance_type": {
      "const": "condition_material_receipt",
      "default": "condition_material_receipt",
      "title": "Governance Type",
      "type": "string"
    },
    "held_out_accessed": {
      "const": false,
      "default": false,
      "title": "Held Out Accessed",
      "type": "boolean"
    },
    "material_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Material Digest",
      "type": "string"
    },
    "padded": {
      "const": false,
      "default": false,
      "title": "Padded",
      "type": "boolean"
    },
    "policy_version": {
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$",
      "title": "Policy Version",
      "type": "string"
    },
    "profile_draft_digest": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Profile Draft Digest"
    },
    "receipt_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Receipt Id",
      "type": "string"
    },
    "registration_ref": {
      "$ref": "#/$defs/BenchmarkRegistrationRef"
    },
    "review_packet_digest": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Review Packet Digest"
    },
    "reviewer_context_id": {
      "anyOf": [
        {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reviewer Context Id"
    },
    "reviewer_identity": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reviewer Identity"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "signature": {
      "$ref": "#/$defs/SignatureEnvelope"
    },
    "source_evaluation_case_ids": {
      "default": [],
      "items": {
        "maxLength": 200,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
        "type": "string"
      },
      "title": "Source Evaluation Case Ids",
      "type": "array"
    },
    "source_task_ids": {
      "default": [],
      "items": {
        "maxLength": 200,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
        "type": "string"
      },
      "title": "Source Task Ids",
      "type": "array"
    },
    "subject_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Subject Id",
      "type": "string"
    },
    "target_visible_tokens": {
      "maximum": 3000,
      "minimum": 0,
      "title": "Target Visible Tokens",
      "type": "integer"
    },
    "target_visible_utf8_bytes": {
      "maximum": 12000,
      "minimum": 0,
      "title": "Target Visible Utf8 Bytes",
      "type": "integer"
    },
    "wrapper_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Wrapper Digest",
      "type": "string"
    }
  },
  "required": [
    "receipt_id",
    "subject_id",
    "benchmark_id",
    "registration_ref",
    "condition",
    "blind_condition_id",
    "wrapper_digest",
    "material_digest",
    "bundle_digest",
    "target_visible_tokens",
    "target_visible_utf8_bytes",
    "construction_method",
    "author_role",
    "authoring_minutes",
    "construction_started_at",
    "frozen_at",
    "policy_version",
    "signature"
  ],
  "title": "ConditionMaterialReceipt",
  "type": "object"
}
