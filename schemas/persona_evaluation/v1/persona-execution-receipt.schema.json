      "type": "boolean"
    },
    "role": {
      "enum": [
        "profile_author",
        "semantic_sensor",
        "judge",
        "adjudicator"
      ],
      "title": "Role",
      "type": "string"
    },
    "rules_loaded": {
      "const": false,
      "default": false,
      "title": "Rules Loaded",
      "type": "boolean"
    },
    "saved_chatgpt_authentication": {
      "const": true,
      "default": true,
      "title": "Saved Chatgpt Authentication",
      "type": "boolean"
    },
    "session_destroyed": {
      "const": true,
      "default": true,
