{
  "additionalProperties": false,
  "properties": {
    "api_key_environment_present": {
      "const": false,
      "default": false,
      "title": "Api Key Environment Present",
      "type": "boolean"
    },
    "cached_input_tokens": {
      "minimum": 0,
      "title": "Cached Input Tokens",
      "type": "integer"
    },
    "case_id": {
      "anyOf": [
        {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Case Id"
    },
    "command_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Command Digest",
      "type": "string"
    },
    "empty_workspace": {
      "const": true,
      "default": true,
      "title": "Empty Workspace",
      "type": "boolean"
    },
    "environment_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Environment Digest",
      "type": "string"
    },
    "exactly_one_persona": {
      "const": true,
      "default": true,
      "title": "Exactly One Persona",
      "type": "boolean"
    },
    "execution_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Execution Id",
      "type": "string"
    },
    "external_validation_accessed": {
      "const": false,
      "default": false,
      "title": "External Validation Accessed",
      "type": "boolean"
    },
    "fresh_ephemeral_session": {
      "const": true,
      "default": true,
      "title": "Fresh Ephemeral Session",
      "type": "boolean"
    },
    "host_home_visible": {
      "const": false,
      "default": false,
      "title": "Host Home Visible",
      "type": "boolean"
    },
    "input_tokens": {
      "minimum": 0,
      "title": "Input Tokens",
      "type": "integer"
    },
    "mcp_loaded": {
      "const": false,
      "default": false,
      "title": "Mcp Loaded",
      "type": "boolean"
    },
    "memories_loaded": {
      "const": false,
      "default": false,
      "title": "Memories Loaded",
      "type": "boolean"
    },
    "model": {
      "enum": [
        "gpt-5.6-luna",
        "gpt-5.6-sol"
      ],
      "title": "Model",
      "type": "string"
    },
    "output_tokens": {
      "minimum": 0,
      "title": "Output Tokens",
      "type": "integer"
    },
    "packet_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Packet Digest",
      "type": "string"
    },
    "persona_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Persona Id",
      "type": "string"
    },
    "plugins_loaded": {
      "const": false,
      "default": false,
      "title": "Plugins Loaded",
      "type": "boolean"
    },
    "prior_transcripts_loaded": {
      "const": false,
      "default": false,
      "title": "Prior Transcripts Loaded",
      "type": "boolean"
    },
    "provider_billed_calls": {
      "const": 0,
      "default": 0,
      "title": "Provider Billed Calls",
      "type": "integer"
    },
