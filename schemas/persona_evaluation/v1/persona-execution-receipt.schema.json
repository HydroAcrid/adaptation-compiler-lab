    },
    "skills_loaded": {
      "const": false,
      "default": false,
      "title": "Skills Loaded",
      "type": "boolean"
    },
    "tools_used": {
      "const": false,
      "default": false,
      "title": "Tools Used",
      "type": "boolean"
    },
    "trace_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Trace Digest",
      "type": "string"
    },
    "user_config_loaded": {
      "const": false,
      "default": false,
      "title": "User Config Loaded",
      "type": "boolean"
    },
    "web_search_enabled": {
      "const": false,
      "default": false,
      "title": "Web Search Enabled",
      "type": "boolean"
    }
  },
  "required": [
    "execution_id",
    "role",
    "persona_id",
    "packet_digest",
    "model",
    "reasoning_effort",
    "input_tokens",
    "cached_input_tokens",
    "output_tokens",
    "reasoning_output_tokens",
    "trace_digest",
    "command_digest",
    "environment_digest"
