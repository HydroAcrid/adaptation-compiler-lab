{
  "$defs": {
    "ActorKind": {
      "enum": [
        "user",
        "human_reviewer",
        "agent",
        "tool",
        "system"
      ],
      "title": "ActorKind",
      "type": "string"
    },
    "ActorRef": {
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Actor Id",
          "type": "string"
        },
        "display_name": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display Name"
        },
        "kind": {
          "$ref": "#/$defs/ActorKind"
        },
        "version": {
          "anyOf": [
            {
              "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "required": [
        "actor_id",
        "kind"
      ],
      "title": "ActorRef",
      "type": "object"
    },
    "AssertionStatus": {
      "enum": [
        "passed",
        "failed",
        "corrected",
        "rejected",
        "unknown"
      ],
      "title": "AssertionStatus",
      "type": "string"
    },
    "ClaimType": {
      "enum": [
        "user_preference",
        "user_correction",
        "user_acceptance",
        "project_requirement",
        "task_outcome",
        "behavioral_effectiveness",
        "repository_fact",
        "external_fact",
        "proposed_lesson",
        "synthetic_expectation"
      ],
      "title": "ClaimType",
      "type": "string"
    },
    "EnvironmentFact": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Name",
          "type": "string"
        },
        "value": {
          "minLength": 1,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "name",
        "value"
      ],
      "title": "EnvironmentFact",
      "type": "object"
    },
    "EnvironmentSnapshot": {
      "additionalProperties": false,
      "properties": {
        "agent_version": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "const": "unknown",
              "type": "string"
            }
          ],
          "default": "unknown",
          "title": "Agent Version"
        },
        "environment_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Environment Id",
          "type": "string"
        },
        "facts": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EnvironmentFact"
          },
          "title": "Facts",
          "type": "array"
        },
        "harness_version": {
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$",
          "title": "Harness Version",
          "type": "string"
        },
        "model_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "const": "unknown",
              "type": "string"
            }
          ],
          "default": "unknown",
          "title": "Model Id"
        },
        "random_seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "const": "unknown",
              "type": "string"
            }
          ],
          "default": "unknown",
          "title": "Random Seed"
        },
        "repository_digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Repository Digest"
        },
        "tool_ids": {
          "default": [],
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Tool Ids",
          "type": "array"
        }
      },
      "required": [
        "environment_id",
        "harness_version"
      ],
      "title": "EnvironmentSnapshot",
      "type": "object"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "content_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Digest",
          "type": "string"
        },
        "record_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Record Id",
          "type": "string"
        },
        "record_type": {
          "const": "evidence",
          "default": "evidence",
          "title": "Record Type",
          "type": "string"
        },
        "record_version": {
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$",
          "title": "Record Version",
          "type": "string"
        }
      },
      "required": [
        "record_id",
        "record_version",
        "content_digest"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "OutcomeAssertion": {
      "additionalProperties": false,
      "properties": {
        "assertion_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Assertion Id",
          "type": "string"
        },
        "claim_type": {
          "$ref": "#/$defs/ClaimType"
        },
        "evaluation_setup": {
          "minLength": 1,
          "title": "Evaluation Setup",
          "type": "string"
        },
        "evaluation_stimulus": {
          "minLength": 1,
          "title": "Evaluation Stimulus",
          "type": "string"
        },
        "expected_behavior": {
          "minLength": 1,
          "title": "Expected Behavior",
          "type": "string"
        },
        "failure_criteria": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Failure Criteria",
          "type": "array"
        },
        "observed_behavior": {
          "minLength": 1,
          "title": "Observed Behavior",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "scoring_rule": {
          "$ref": "#/$defs/ScoringRule"
        },
        "statement": {
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/AssertionStatus"
        }
      },
      "required": [
        "assertion_id",
        "claim_type",
        "status",
        "statement",
        "observed_behavior",
        "expected_behavior",
        "evaluation_setup",
        "evaluation_stimulus",
        "failure_criteria",
        "scoring_rule",
        "scope"
      ],
      "title": "OutcomeAssertion",
      "type": "object"
    },
    "OutcomeKind": {
      "enum": [
        "accepted",
        "edited",
        "rejected",
        "reverted",
        "test_result",
        "explicit_rating",
        "success",
        "partial_success",
        "failure",
        "correction",
        "unknown"
      ],
      "title": "OutcomeKind",
      "type": "string"
    },
    "Partition": {
      "enum": [
        "construction",
        "development",
        "held_out",
        "synthetic"
      ],
      "title": "Partition",
      "type": "string"
    },
    "PermittedUse": {
      "enum": [
        "construction",
        "development_evaluation",
        "promotion",
        "target_delivery",
        "benchmark",
        "audit"
      ],
      "title": "PermittedUse",
      "type": "string"
    },
    "PrivacyContext": {
      "additionalProperties": false,
      "properties": {
        "consent_basis": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Consent Basis",
          "type": "string"
        },
        "consent_basis_refs": {
          "default": [],
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Consent Basis Refs",
          "type": "array"
        },
        "notes": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "permitted_uses": {
          "items": {
            "$ref": "#/$defs/PermittedUse"
          },
          "minItems": 1,
          "title": "Permitted Uses",
          "type": "array"
        },
        "review_state": {
          "$ref": "#/$defs/PrivacyReviewState",
          "default": "pending"
        },
        "reviewed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewed At"
        },
        "reviewed_by": {
          "anyOf": [
            {
              "$ref": "#/$defs/ActorRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "sensitivity": {
          "$ref": "#/$defs/SensitivityClass"
        }
      },
      "required": [
        "sensitivity",
        "consent_basis",
        "permitted_uses"
      ],
      "title": "PrivacyContext",
      "type": "object"
    },
    "PrivacyReviewState": {
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "title": "PrivacyReviewState",
      "type": "string"
    },
    "Scope": {
      "additionalProperties": false,
      "description": "Machine-comparable applicability bounds.\n\nEmpty optional dimensions mean unconstrained. Subjects are never unconstrained in this\nsingle-user prototype. A narrower scope may restrict a dimension, add exclusions or\nactivation conditions, and shrink the validity window.",
      "properties": {
        "activation_conditions": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Activation Conditions",
          "type": "array"
        },
        "environment_ids": {
          "default": [],
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Environment Ids",
          "type": "array"
        },
        "exclusions": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Exclusions",
          "type": "array"
        },
        "project_ids": {
          "default": [],
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Project Ids",
          "type": "array"
        },
        "repository_ids": {
          "default": [],
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Repository Ids",
          "type": "array"
        },
        "subject_ids": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Subject Ids",
          "type": "array"
        },
        "target_families": {
          "default": [],
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Target Families",
          "type": "array"
        },
        "task_classes": {
          "default": [],
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Task Classes",
          "type": "array"
        },
        "valid_from": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid From"
        },
        "valid_until": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid Until"
        },
        "workspace_ids": {
          "default": [],
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Workspace Ids",
          "type": "array"
        }
      },
      "required": [
        "subject_ids"
      ],
      "title": "Scope",
      "type": "object"
    },
    "ScoringRule": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "pass_threshold": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pass Threshold"
        },
        "scoring_type": {
          "$ref": "#/$defs/ScoringType"
        }
      },
      "required": [
        "scoring_type",
        "description"
      ],
      "title": "ScoringRule",
      "type": "object"
    },
    "ScoringType": {
      "enum": [
        "objective",
        "subjective",
        "hybrid"
      ],
      "title": "ScoringType",
      "type": "string"
    },
    "SensitivityClass": {
      "enum": [
        "public",
        "internal",
        "private",
        "confidential",
        "restricted",
        "prohibited_secret"
      ],
      "title": "SensitivityClass",
      "type": "string"
    },
    "TaskRecordRef": {
      "additionalProperties": false,
      "properties": {
        "content_digest": {
          "const": null,
          "default": null,
          "title": "Content Digest",
          "type": "null"
        },
        "record_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Record Id",
          "type": "string"
        },
        "record_type": {
          "const": "task_record",
          "default": "task_record",
          "title": "Record Type",
          "type": "string"
        },
        "record_version": {
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$",
          "title": "Record Version",
          "type": "string"
        }
      },
      "required": [
        "record_id",
        "record_version"
      ],
      "title": "TaskRecordRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Scoped assessment of a completed task; it never erases other assessments.",
  "properties": {
    "assertions": {
      "default": [],
      "items": {
        "$ref": "#/$defs/OutcomeAssertion"
      },
      "title": "Assertions",
      "type": "array"
    },
    "assessed_at": {
      "format": "date-time",
      "title": "Assessed At",
      "type": "string"
    },
    "contradicting_evidence_refs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      },
      "title": "Contradicting Evidence Refs",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "created_by": {
      "$ref": "#/$defs/ActorRef"
    },
    "environment": {
      "$ref": "#/$defs/EnvironmentSnapshot"
    },
    "evaluator": {
      "$ref": "#/$defs/ActorRef"
    },
    "kind": {
      "$ref": "#/$defs/OutcomeKind"
    },
    "partition": {
      "$ref": "#/$defs/Partition"
    },
    "policy_version": {
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$",
      "title": "Policy Version",
      "type": "string"
    },
    "privacy": {
      "$ref": "#/$defs/PrivacyContext"
    },
    "record_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Record Id",
      "type": "string"
    },
    "record_type": {
      "const": "outcome",
      "default": "outcome",
      "title": "Record Type",
      "type": "string"
    },
    "record_version": {
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$",
      "title": "Record Version",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/Scope"
    },
    "supporting_evidence_refs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      },
      "title": "Supporting Evidence Refs",
      "type": "array"
    },
    "task_ref": {
      "$ref": "#/$defs/TaskRecordRef"
    }
  },
  "required": [
    "record_id",
    "record_version",
    "created_at",
    "created_by",
    "policy_version",
    "task_ref",
    "kind",
    "assessed_at",
    "evaluator",
    "scope",
    "environment",
    "privacy",
    "partition"
  ],
  "title": "Outcome",
  "type": "object"
}
