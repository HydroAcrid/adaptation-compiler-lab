        "semantic_decision_table_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Semantic Decision Table Version",
          "type": "string"
        }
      },
      "required": [
        "artifact_ref",
        "cases"
      ],
      "title": "SemanticDecisionTable",
      "type": "object"
    },
    "SensitivityClass": {
      "enum": [
        "public",
        "internal",
        "private",
        "confidential",
        "restricted",
        "prohibited_secret"
      ],
      "title": "SensitivityClass",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Semantic decision projection over an immutable governed release.",
  "properties": {
    "decision_tables": {
      "items": {
        "$ref": "#/$defs/SemanticDecisionTable"
      },
      "minItems": 1,
      "title": "Decision Tables",
