{
  "$defs": {
    "ActorKind": {
      "enum": [
        "user",
        "human_reviewer",
        "agent",
        "tool",
        "system"
      ],
      "title": "ActorKind",
      "type": "string"
    },
    "ActorRef": {
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Actor Id",
          "type": "string"
        },
        "display_name": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display Name"
        },
        "kind": {
          "$ref": "#/$defs/ActorKind"
        },
        "version": {
          "anyOf": [
            {
              "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "required": [
        "actor_id",
        "kind"
      ],
      "title": "ActorRef",
      "type": "object"
    },
    "ArtifactGovernanceBinding": {
      "additionalProperties": false,
      "description": "Complete active artifact lineage retained in the external release.",
      "properties": {
        "artifact_ref": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "capture_refs": {
          "items": {
            "$ref": "#/$defs/CaptureReceiptRef"
          },
          "minItems": 1,
          "title": "Capture Refs",
          "type": "array"
        },
        "consent_refs": {
          "items": {
            "$ref": "#/$defs/ConsentReceiptRef"
          },
          "minItems": 1,
          "title": "Consent Refs",
          "type": "array"
        },
        "evaluation_case_refs": {
          "items": {
            "$ref": "#/$defs/EvaluationCaseRef"
          },
          "minItems": 1,
          "title": "Evaluation Case Refs",
          "type": "array"
        },
        "evidence_links": {
          "$ref": "#/$defs/EvidenceLinks"
        },
        "review_approver_ids": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Review Approver Ids",
          "type": "array"
        },
        "review_policy_versions": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Review Policy Versions",
          "type": "array"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        }
      },
      "required": [
        "artifact_ref",
        "scope",
        "evidence_links",
        "evaluation_case_refs",
        "consent_refs",
        "capture_refs",
        "review_approver_ids",
        "review_policy_versions"
      ],
      "title": "ArtifactGovernanceBinding",
      "type": "object"
    },
    "ArtifactKind": {
      "enum": [
        "memory",
        "preference",
        "example",
        "procedure",
        "prompt_rule",
        "skill",
        "tool_recommendation"
      ],
      "title": "ArtifactKind",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "content_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Digest",
          "type": "string"
        },
        "record_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Record Id",
          "type": "string"
        },
        "record_type": {
          "const": "artifact",
          "default": "artifact",
          "title": "Record Type",
          "type": "string"
        },
        "record_version": {
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$",
          "title": "Record Version",
          "type": "string"
        }
      },
      "required": [
        "record_id",
        "record_version",
        "content_digest"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "ArtifactRenderProjection": {
      "additionalProperties": false,
      "description": "Minimum approved behavioral artifact accepted by file renderers.",
      "properties": {
        "artifact_ref": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "artifact_type": {
          "$ref": "#/$defs/ArtifactKind"
        },
        "behavioral_contract": {
          "$ref": "#/$defs/BehavioralContract"
        },
        "claim_authorities": {
          "$ref": "#/$defs/ClaimAuthoritySet"
        },
        "evaluation_cases": {
          "items": {
            "$ref": "#/$defs/EvaluationCaseRef"
          },
          "minItems": 1,
          "title": "Evaluation Cases",
          "type": "array"
        },
        "evidence_links": {
          "$ref": "#/$defs/EvidenceLinks"
        },
        "expires_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expires At"
        },
        "precedence": {
          "default": 0,
          "maximum": 10000,
          "minimum": -10000,
          "title": "Precedence",
          "type": "integer"
        },
        "privacy": {
          "$ref": "#/$defs/PrivacyContext"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "review_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Review At"
        },
        "revoked": {
          "default": false,
          "title": "Revoked",
          "type": "boolean"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "source_partitions": {
          "items": {
            "$ref": "#/$defs/Partition"
          },
          "minItems": 1,
          "title": "Source Partitions",
          "type": "array"
        },
        "target_compatibility": {
          "default": [],
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Target Compatibility",
          "type": "array"
        }
      },
      "required": [
        "artifact_ref",
        "artifact_type",
        "behavioral_contract",
        "scope",
        "evidence_links",
        "evaluation_cases",
        "claim_authorities",
        "privacy",
        "source_partitions"
      ],
      "title": "ArtifactRenderProjection",
      "type": "object"
    },
    "AuthorityClass": {
      "enum": [
        "user_normative",
        "authorized_evaluator",
        "project_policy",
        "observational",
        "proposal_only",
        "untrusted_context",
        "synthetic_only"
      ],
      "title": "AuthorityClass",
      "type": "string"
    },
    "BehavioralContract": {
      "additionalProperties": false,
      "properties": {
        "intent": {
          "minLength": 1,
          "title": "Intent",
          "type": "string"
        },
        "non_goals": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Non Goals",
          "type": "array"
        },
        "required_behaviors": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Required Behaviors",
          "type": "array"
        },
        "verification_requirements": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Verification Requirements",
          "type": "array"
        }
      },
      "required": [
        "intent",
        "required_behaviors",
        "verification_requirements"
      ],
      "title": "BehavioralContract",
      "type": "object"
    },
    "CaptureReceiptRef": {
      "additionalProperties": false,
      "properties": {
        "content_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Digest",
          "type": "string"
        },
        "governance_type": {
          "const": "capture_receipt",
          "default": "capture_receipt",
          "title": "Governance Type",
          "type": "string"
        },
        "object_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Object Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "object_id",
        "content_digest"
      ],
      "title": "CaptureReceiptRef",
      "type": "object"
    },
    "ClaimAuthority": {
      "additionalProperties": false,
      "description": "Claim-specific authority that a renderer must preserve without strengthening.",
      "properties": {
        "authority_class": {
          "$ref": "#/$defs/AuthorityClass"
        },
        "claim_type": {
          "$ref": "#/$defs/ClaimType"
        },
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array"
        }
      },
      "required": [
        "claim_type",
        "authority_class",
        "evidence_refs"
      ],
      "title": "ClaimAuthority",
      "type": "object"
    },
    "ClaimAuthoritySet": {
      "additionalProperties": false,
      "properties": {
        "entries": {
          "items": {
            "$ref": "#/$defs/ClaimAuthority"
          },
          "minItems": 1,
          "title": "Entries",
          "type": "array"
        }
      },
      "required": [
        "entries"
      ],
      "title": "ClaimAuthoritySet",
      "type": "object"
    },
    "ClaimType": {
      "enum": [
        "user_preference",
        "user_correction",
        "user_acceptance",
        "project_requirement",
        "task_outcome",
        "behavioral_effectiveness",
        "repository_fact",
        "external_fact",
        "proposed_lesson",
        "synthetic_expectation"
      ],
      "title": "ClaimType",
      "type": "string"
    },
    "ConsentReceiptRef": {
      "additionalProperties": false,
      "properties": {
        "content_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Digest",
          "type": "string"
        },
        "governance_type": {
          "const": "consent_receipt",
          "default": "consent_receipt",
          "title": "Governance Type",
          "type": "string"
        },
        "object_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Object Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "object_id",
        "content_digest"
      ],
      "title": "ConsentReceiptRef",
      "type": "object"
    },
    "DecisionOperation": {
      "description": "Portable behavioral operation rendered into target-natural language.",
      "enum": [
        "create_recoverable_backup",
        "replace_contents",
        "prepare_temporary_replacement",
        "activate_atomically",
        "refuse_replacement",
        "preserve_behavior"
      ],
      "title": "DecisionOperation",
      "type": "string"
    },
    "DecisionResourceClass": {
      "description": "Portable resource class used by a behavioral decision.",
      "enum": [
        "persistent_user_managed",
        "disposable_generated_cache",
        "unlisted"
      ],
      "title": "DecisionResourceClass",
      "type": "string"
    },
    "EvaluationCaseRef": {
      "additionalProperties": false,
      "properties": {
        "content_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Digest",
          "type": "string"
        },
        "record_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Record Id",
          "type": "string"
        },
        "record_type": {
          "const": "evaluation_case",
          "default": "evaluation_case",
          "title": "Record Type",
          "type": "string"
        },
        "record_version": {
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$",
          "title": "Record Version",
          "type": "string"
        }
      },
      "required": [
        "record_id",
        "record_version",
        "content_digest"
      ],
      "title": "EvaluationCaseRef",
      "type": "object"
    },
    "EvidenceLinks": {
      "additionalProperties": false,
      "description": "Direct evidence roles retained by every lesson and artifact.",
      "properties": {
        "contradicting": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Contradicting",
          "type": "array"
        },
        "review_complete": {
          "const": true,
          "default": true,
          "title": "Review Complete",
          "type": "boolean"
        },
        "scope_limiting": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Scope Limiting",
          "type": "array"
        },
        "supporting": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "minItems": 1,
          "title": "Supporting",
          "type": "array"
        }
      },
      "required": [
        "supporting"
      ],
      "title": "EvidenceLinks",
      "type": "object"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "content_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Digest",
          "type": "string"
        },
        "record_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Record Id",
          "type": "string"
        },
        "record_type": {
          "const": "evidence",
          "default": "evidence",
          "title": "Record Type",
          "type": "string"
        },
        "record_version": {
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$",
          "title": "Record Version",
          "type": "string"
        }
      },
      "required": [
        "record_id",
        "record_version",
        "content_digest"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "ExternalGovernedRelease": {
      "additionalProperties": false,
      "description": "Portable user-owned release; complete for audit and rollback, not target-visible.",
      "properties": {
        "active_artifacts": {
          "items": {
            "$ref": "#/$defs/ArtifactRenderProjection"
          },
          "title": "Active Artifacts",
          "type": "array"
        },
        "active_bindings": {
          "items": {
            "$ref": "#/$defs/ArtifactGovernanceBinding"
          },
          "title": "Active Bindings",
          "type": "array"
        },
        "external_release_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "External Release Version",
          "type": "string"
        },
        "lifecycle_history": {
          "items": {
            "$ref": "#/$defs/GovernedLifecycleEvent"
          },
          "minItems": 1,
          "title": "Lifecycle History",
          "type": "array"
        },
        "parent_release_digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Release Digest"
        },
        "release_ref": {
          "$ref": "#/$defs/ReleaseRef"
        },
        "renderer_id": {
          "const": "compact-runtime-projection",
          "default": "compact-runtime-projection",
          "title": "Renderer Id",
          "type": "string"
        },
        "renderer_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Renderer Version",
          "type": "string"
        },
        "revoked_artifact_ids": {
          "default": [],
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Revoked Artifact Ids",
          "type": "array"
        },
        "scoped_supersessions": {
          "default": [],
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "maxLength": 200,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
                "type": "string"
              },
              {
                "maxLength": 200,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
                "type": "string"
              }
            ],
            "type": "array"
          },
          "title": "Scoped Supersessions",
          "type": "array"
        },
        "source_snapshot_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Source Snapshot Digest",
          "type": "string"
        }
      },
      "required": [
        "release_ref",
        "source_snapshot_digest",
        "active_artifacts",
        "active_bindings",
        "lifecycle_history"
      ],
      "title": "ExternalGovernedRelease",
      "type": "object"
    },
    "GovernedLifecycleEvent": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "transition_kind": {
                "const": "addition"
              }
            },
            "required": [
              "transition_kind"
            ]
          },
          "then": {
            "properties": {
              "affected_artifact_id": {
                "type": "null"
              },
              "introduced_artifact_ref": {
                "not": {
                  "type": "null"
                }
              },
              "supersedes_artifact_ids": {
                "maxItems": 0
              }
            },
            "required": [
              "introduced_artifact_ref"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "transition_kind": {
                "enum": [
                  "scoped_correction",
                  "supersession"
                ]
              }
            },
            "required": [
              "transition_kind"
            ]
          },
          "then": {
            "properties": {
              "affected_artifact_id": {
                "type": "string"
              },
              "introduced_artifact_ref": {
                "not": {
                  "type": "null"
                }
              },
              "supersedes_artifact_ids": {
                "maxItems": 1,
                "minItems": 1
              }
            },
            "required": [
              "introduced_artifact_ref",
              "affected_artifact_id",
              "supersedes_artifact_ids"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "transition_kind": {
                "const": "revocation"
              }
            },
            "required": [
              "transition_kind"
            ]
          },
          "then": {
            "properties": {
              "affected_artifact_id": {
                "type": "string"
              },
              "introduced_artifact_ref": {
                "type": "null"
              },
              "supersedes_artifact_ids": {
                "maxItems": 0
              }
            },
            "required": [
              "affected_artifact_id"
            ]
          }
        }
      ],
      "description": "Content-addressed lifecycle history retained outside the target prompt.",
      "properties": {
        "activated_at": {
          "format": "date-time",
          "title": "Activated At",
          "type": "string"
        },
        "affected_artifact_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Affected Artifact Id"
        },
        "capture_ref": {
          "$ref": "#/$defs/CaptureReceiptRef"
        },
        "consent_ref": {
          "$ref": "#/$defs/ConsentReceiptRef"
        },
        "evaluation_case_ref": {
          "$ref": "#/$defs/EvaluationCaseRef"
        },
        "event_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Event Id",
          "type": "string"
        },
        "evidence_ref": {
          "$ref": "#/$defs/EvidenceRef"
        },
        "introduced_artifact_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "released_at": {
          "format": "date-time",
          "title": "Released At",
          "type": "string"
        },
        "review_approver_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Review Approver Id",
          "type": "string"
        },
        "review_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Review Digest",
          "type": "string"
        },
        "review_policy_version": {
          "minLength": 1,
          "title": "Review Policy Version",
          "type": "string"
        },
        "stage": {
          "minimum": 1,
          "title": "Stage",
          "type": "integer"
        },
        "supersedes_artifact_ids": {
          "default": [],
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Supersedes Artifact Ids",
          "type": "array"
        },
        "transition_kind": {
          "enum": [
            "addition",
            "scoped_correction",
            "supersession",
            "revocation"
          ],
          "title": "Transition Kind",
          "type": "string"
        }
      },
      "required": [
        "event_id",
        "stage",
        "transition_kind",
        "evidence_ref",
        "consent_ref",
        "capture_ref",
        "evaluation_case_ref",
        "review_digest",
        "review_approver_id",
        "review_policy_version",
        "released_at",
        "activated_at"
      ],
      "title": "GovernedLifecycleEvent",
      "type": "object"
    },
    "Partition": {
      "enum": [
        "construction",
        "development",
        "held_out",
        "synthetic"
      ],
      "title": "Partition",
      "type": "string"
    },
    "PermittedUse": {
      "enum": [
        "construction",
        "development_evaluation",
        "promotion",
        "target_delivery",
        "benchmark",
        "audit"
      ],
      "title": "PermittedUse",
      "type": "string"
    },
    "PrivacyContext": {
      "additionalProperties": false,
      "properties": {
        "consent_basis": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Consent Basis",
          "type": "string"
        },
        "consent_basis_refs": {
          "default": [],
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Consent Basis Refs",
          "type": "array"
        },
        "notes": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "permitted_uses": {
          "items": {
            "$ref": "#/$defs/PermittedUse"
          },
          "minItems": 1,
          "title": "Permitted Uses",
          "type": "array"
        },
        "review_state": {
          "$ref": "#/$defs/PrivacyReviewState",
          "default": "pending"
        },
        "reviewed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewed At"
        },
        "reviewed_by": {
          "anyOf": [
            {
              "$ref": "#/$defs/ActorRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "sensitivity": {
          "$ref": "#/$defs/SensitivityClass"
        }
      },
      "required": [
        "sensitivity",
        "consent_basis",
        "permitted_uses"
      ],
      "title": "PrivacyContext",
      "type": "object"
    },
    "PrivacyReviewState": {
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "title": "PrivacyReviewState",
      "type": "string"
    },
    "RecoveryRequestState": {
      "description": "Whether an explicit recovery request is part of a decision branch.",
      "enum": [
        "requested",
        "not_requested",
        "either",
        "not_applicable"
      ],
      "title": "RecoveryRequestState",
      "type": "string"
    },
    "ReleaseRef": {
      "additionalProperties": false,
      "properties": {
        "content_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Digest",
          "type": "string"
        },
        "record_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Record Id",
          "type": "string"
        },
        "record_type": {
          "const": "release",
          "default": "release",
          "title": "Record Type",
          "type": "string"
        },
        "record_version": {
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$",
          "title": "Record Version",
          "type": "string"
        }
      },
      "required": [
        "record_id",
        "record_version",
        "content_digest"
      ],
      "title": "ReleaseRef",
      "type": "object"
    },
    "Scope": {
      "additionalProperties": false,
      "description": "Machine-comparable applicability bounds.\n\nEmpty optional dimensions mean unconstrained. Subjects are never unconstrained in this\nsingle-user prototype. A narrower scope may restrict a dimension, add exclusions or\nactivation conditions, and shrink the validity window.",
      "properties": {
        "activation_conditions": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Activation Conditions",
          "type": "array"
        },
        "environment_ids": {
          "default": [],
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Environment Ids",
          "type": "array"
        },
        "exclusions": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Exclusions",
          "type": "array"
        },
        "project_ids": {
          "default": [],
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Project Ids",
          "type": "array"
        },
        "repository_ids": {
          "default": [],
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Repository Ids",
          "type": "array"
        },
        "subject_ids": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Subject Ids",
          "type": "array"
        },
        "target_families": {
          "default": [],
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Target Families",
          "type": "array"
        },
        "task_classes": {
          "default": [],
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Task Classes",
          "type": "array"
        },
        "valid_from": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid From"
        },
        "valid_until": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid Until"
        },
        "workspace_ids": {
          "default": [],
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Workspace Ids",
          "type": "array"
        }
      },
      "required": [
        "subject_ids"
      ],
      "title": "Scope",
      "type": "object"
    },
    "SemanticDecisionCase": {
      "additionalProperties": false,
      "description": "One machine-checkable portable branch without target-specific wording.",
      "properties": {
        "case_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Case Id",
          "type": "string"
        },
        "forbidden_operations": {
          "default": [],
          "items": {
            "$ref": "#/$defs/DecisionOperation"
          },
          "title": "Forbidden Operations",
          "type": "array"
        },
        "recovery_request": {
          "$ref": "#/$defs/RecoveryRequestState"
        },
        "required_operations": {
          "items": {
            "$ref": "#/$defs/DecisionOperation"
          },
          "minItems": 1,
          "title": "Required Operations",
          "type": "array"
        },
        "resource_class": {
          "$ref": "#/$defs/DecisionResourceClass"
        }
      },
      "required": [
        "case_id",
        "resource_class",
        "recovery_request",
        "required_operations"
      ],
      "title": "SemanticDecisionCase",
      "type": "object"
    },
    "SemanticDecisionTable": {
      "additionalProperties": false,
      "description": "Portable semantic cases bound to one exact governed artifact.",
      "properties": {
        "artifact_ref": {
          "$ref": "#/$defs/ArtifactRef"
