      "type": "string"
    },
    "governed_release": {
      "$ref": "#/$defs/ExternalGovernedRelease"
    }
  },
  "required": [
    "governed_release",
    "decision_tables"
  ],
  "title": "ExternalSemanticDecisionRelease",
  "type": "object"
}
