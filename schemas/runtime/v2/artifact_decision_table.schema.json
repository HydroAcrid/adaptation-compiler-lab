{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "content_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Digest",
          "type": "string"
        },
        "record_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Record Id",
          "type": "string"
        },
        "record_type": {
          "const": "artifact",
          "default": "artifact",
          "title": "Record Type",
          "type": "string"
        },
        "record_version": {
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$",
          "title": "Record Version",
          "type": "string"
        }
      },
      "required": [
        "record_id",
        "record_version",
        "content_digest"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "BehavioralDecisionCase": {
      "additionalProperties": false,
      "description": "One explicit branch of a promoted behavioral decision.",
      "properties": {
        "case_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Case Id",
          "type": "string"
        },
        "forbidden_actions": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Forbidden Actions",
          "type": "array"
        },
        "required_actions": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Required Actions",
          "type": "array"
        },
        "situation": {
          "minLength": 1,
          "title": "Situation",
          "type": "string"
        }
      },
      "required": [
        "case_id",
        "situation",
        "required_actions"
      ],
      "title": "BehavioralDecisionCase",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Typed decision branches bound to one exact governed artifact.",
  "properties": {
    "artifact_ref": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "cases": {
      "items": {
        "$ref": "#/$defs/BehavioralDecisionCase"
      },
      "minItems": 1,
      "title": "Cases",
      "type": "array"
    },
    "decision_table_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Decision Table Version",
      "type": "string"
    }
  },
  "required": [
    "artifact_ref",
    "cases"
  ],
  "title": "ArtifactDecisionTable",
  "type": "object"
}
