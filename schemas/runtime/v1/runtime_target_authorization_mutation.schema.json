{
  "additionalProperties": false,
  "description": "Raw-free renderer result for one signed target-authorization decision.",
  "properties": {
    "authorization_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Authorization Digest",
      "type": "string"
    },
    "authorized_artifact_count": {
      "minimum": 0,
      "title": "Authorized Artifact Count",
      "type": "integer"
    },
    "decision": {
      "enum": [
        "authorize",
        "revoke"
      ],
      "title": "Decision",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "mutation_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Mutation Version",
      "type": "string"
    },
    "provider_call_required": {
      "const": false,
      "default": false,
      "title": "Provider Call Required",
      "type": "boolean"
    },
    "raw_paths_exposed": {
      "const": false,
      "default": false,
      "title": "Raw Paths Exposed",
      "type": "boolean"
    },
    "receipt_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Receipt Id",
      "type": "string"
    }
  },
  "required": [
    "receipt_id",
    "decision",
    "authorization_digest",
    "authorized_artifact_count",
    "expires_at"
  ],
  "title": "RuntimeTargetAuthorizationMutationV1",
  "type": "object"
}
