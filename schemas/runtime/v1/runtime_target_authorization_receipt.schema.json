{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "content_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Digest",
          "type": "string"
        },
        "record_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Record Id",
          "type": "string"
        },
        "record_type": {
          "const": "artifact",
          "default": "artifact",
          "title": "Record Type",
          "type": "string"
        },
        "record_version": {
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$",
          "title": "Record Version",
          "type": "string"
        }
      },
      "required": [
        "record_id",
        "record_version",
        "content_digest"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "SignatureEnvelope": {
      "additionalProperties": false,
      "description": "Detached Ed25519 signature metadata included in a signed object.",
      "properties": {
        "algorithm": {
          "const": "Ed25519",
          "default": "Ed25519",
          "title": "Algorithm",
          "type": "string"
        },
        "canonicalization_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Canonicalization Version",
          "type": "string"
        },
        "key_fingerprint": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Key Fingerprint",
          "type": "string"
        },
        "purpose": {
          "minLength": 1,
          "title": "Purpose",
          "type": "string"
        },
        "signature_base64": {
          "minLength": 1,
          "title": "Signature Base64",
          "type": "string"
        },
        "signed_at": {
          "format": "date-time",
          "title": "Signed At",
          "type": "string"
        },
        "signer_identity_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Signer Identity Id",
          "type": "string"
        }
      },
      "required": [
        "signer_identity_id",
        "key_fingerprint",
        "purpose",
        "signed_at",
        "signature_base64"
      ],
      "title": "SignatureEnvelope",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Signed replacement set for one project's target-specific artifact authority.",
  "properties": {
    "authorized_artifact_refs": {
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "title": "Authorized Artifact Refs",
      "type": "array"
    },
    "decided_at": {
      "format": "date-time",
      "title": "Decided At",
      "type": "string"
    },
    "decision": {
      "enum": [
        "authorize",
        "revoke"
      ],
      "title": "Decision",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "previous_authorization_digest": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Previous Authorization Digest"
    },
    "project_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Project Id",
      "type": "string"
    },
    "raw_paths_exposed": {
      "const": false,
      "default": false,
      "title": "Raw Paths Exposed",
      "type": "boolean"
    },
    "receipt_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Receipt Id",
      "type": "string"
    },
    "receipt_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Receipt Version",
      "type": "string"
    },
    "signature": {
      "$ref": "#/$defs/SignatureEnvelope"
    },
    "source_release_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Source Release Digest",
      "type": "string"
    },
    "subject_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Subject Id",
      "type": "string"
    },
    "target_family": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Target Family",
      "type": "string"
    }
  },
  "required": [
    "receipt_id",
    "subject_id",
    "project_id",
    "target_family",
    "decision",
    "source_release_digest",
    "authorized_artifact_refs",
    "decided_at",
    "expires_at",
    "signature"
  ],
  "title": "RuntimeTargetAuthorizationReceiptV1",
  "type": "object"
}
