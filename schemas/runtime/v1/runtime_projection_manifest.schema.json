{
  "$defs": {
    "ClauseProvenanceBinding": {
      "additionalProperties": false,
      "description": "Hidden exact binding from one rendered clause to governed lineage.",
      "properties": {
        "clause_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Clause Digest",
          "type": "string"
        },
        "rendered_fragment_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Rendered Fragment Digest",
          "type": "string"
        },
        "source_binding_digests": {
          "items": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Binding Digests",
          "type": "array"
        }
      },
      "required": [
        "clause_digest",
        "rendered_fragment_digest",
        "source_binding_digests"
      ],
      "title": "ClauseProvenanceBinding",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "External manifest; never delivered with the target-visible projection.",
  "properties": {
    "clause_bindings": {
      "items": {
        "$ref": "#/$defs/ClauseProvenanceBinding"
      },
      "title": "Clause Bindings",
      "type": "array"
    },
    "external_release_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "External Release Digest",
      "type": "string"
    },
    "instruction_environment_digest": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Instruction Environment Digest"
    },
    "manifest_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Manifest Version",
      "type": "string"
    },
    "native_blocked_clause_digests": {
      "default": [],
      "items": {
        "pattern": "^sha256:[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Native Blocked Clause Digests",
      "type": "array"
    },
    "native_delta_fully_optimized": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Native Delta Fully Optimized"
    },
    "native_included_clause_digests": {
      "default": [],
      "items": {
        "pattern": "^sha256:[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Native Included Clause Digests",
      "type": "array"
    },
    "native_managed_session_isolation_required": {
      "default": false,
      "title": "Native Managed Session Isolation Required",
      "type": "boolean"
    },
    "native_omitted_clause_digests": {
      "default": [],
      "items": {
        "pattern": "^sha256:[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Native Omitted Clause Digests",
      "type": "array"
    },
    "native_reconciliation_plan_digest": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Native Reconciliation Plan Digest"
    },
    "native_relation_digests": {
      "default": [],
      "items": {
        "pattern": "^sha256:[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Native Relation Digests",
      "type": "array"
    },
    "native_source_chain_digest": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Native Source Chain Digest"
    },
    "native_target_id": {
      "anyOf": [
        {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Native Target Id"
    },
    "native_target_surface": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Native Target Surface"
    },
    "native_target_surface_version": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Native Target Surface Version"
    },
    "native_unresolved_conflict_ids": {
      "default": [],
      "items": {
        "maxLength": 200,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
        "type": "string"
      },
      "title": "Native Unresolved Conflict Ids",
      "type": "array"
    },
    "rendered_content_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Rendered Content Digest",
      "type": "string"
    },
    "rendered_utf8_bytes": {
      "minimum": 0,
      "title": "Rendered Utf8 Bytes",
      "type": "integer"
    },
    "runtime_projection_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Runtime Projection Digest",
      "type": "string"
    },
    "target_renderer_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Target Renderer Id",
      "type": "string"
    },
    "target_renderer_version": {
      "minLength": 1,
      "title": "Target Renderer Version",
      "type": "string"
    }
  },
  "required": [
    "external_release_digest",
    "runtime_projection_digest",
    "target_renderer_id",
    "target_renderer_version",
    "rendered_content_digest",
    "rendered_utf8_bytes",
    "clause_bindings"
  ],
  "title": "RuntimeProjectionManifest",
  "type": "object"
}
