{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "content_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Digest",
          "type": "string"
        },
        "record_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Record Id",
          "type": "string"
        },
        "record_type": {
          "const": "artifact",
          "default": "artifact",
          "title": "Record Type",
          "type": "string"
        },
        "record_version": {
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$",
          "title": "Record Version",
          "type": "string"
        }
      },
      "required": [
        "record_id",
        "record_version",
        "content_digest"
      ],
      "title": "ArtifactRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One approved artifact considered for an exact target extension.",
  "properties": {
    "already_compatible": {
      "title": "Already Compatible",
      "type": "boolean"
    },
    "artifact_ref": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "behavior_summary": {
      "minLength": 1,
      "title": "Behavior Summary",
      "type": "string"
    },
    "scope_summary": {
      "minLength": 1,
      "title": "Scope Summary",
      "type": "string"
    }
  },
  "required": [
    "artifact_ref",
    "behavior_summary",
    "scope_summary",
    "already_compatible"
  ],
  "title": "RuntimeTargetAuthorizationItemV1",
  "type": "object"
}
