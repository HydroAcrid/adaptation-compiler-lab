{
  "$defs": {
    "ActorKind": {
      "enum": [
        "user",
        "human_reviewer",
        "agent",
        "tool",
        "system"
      ],
      "title": "ActorKind",
      "type": "string"
    },
    "ActorRef": {
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Actor Id",
          "type": "string"
        },
        "display_name": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display Name"
        },
        "kind": {
          "$ref": "#/$defs/ActorKind"
        },
        "version": {
          "anyOf": [
            {
              "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "required": [
        "actor_id",
        "kind"
      ],
      "title": "ActorRef",
      "type": "object"
    },
    "AdaptationLayer": {
      "description": "Separately governed inputs combined by the future product runtime.",
      "enum": [
        "permanent_profile",
        "current_context",
        "temporary_capability_preset",
        "personal_preset_overlay"
      ],
      "title": "AdaptationLayer",
      "type": "string"
    },
    "Approval": {
      "additionalProperties": false,
      "properties": {
        "approver": {
          "$ref": "#/$defs/ActorRef"
        },
        "decided_at": {
          "format": "date-time",
          "title": "Decided At",
          "type": "string"
        },
        "decision": {
          "$ref": "#/$defs/ApprovalDecision"
        },
        "policy_version": {
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$",
          "title": "Policy Version",
          "type": "string"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "decision",
        "approver",
        "decided_at",
        "policy_version",
        "rationale"
      ],
      "title": "Approval",
      "type": "object"
    },
    "ApprovalDecision": {
      "enum": [
        "approved",
        "rejected"
      ],
      "title": "ApprovalDecision",
      "type": "string"
    },
    "GovernanceEvent": {
      "additionalProperties": false,
      "description": "Signed review, release, activation, or custody action.",
      "properties": {
        "decision": {
          "minLength": 1,
          "title": "Decision",
          "type": "string"
        },
        "event_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Event Id",
          "type": "string"
        },
        "event_type": {
          "$ref": "#/$defs/GovernanceEventType"
        },
        "governance_type": {
          "const": "governance_event",
          "default": "governance_event",
          "title": "Governance Type",
          "type": "string"
        },
        "occurred_at": {
          "format": "date-time",
          "title": "Occurred At",
          "type": "string"
        },
        "policy_version": {
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$",
          "title": "Policy Version",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "signature": {
          "$ref": "#/$defs/SignatureEnvelope"
        },
        "subject_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Subject Id",
          "type": "string"
        },
        "target_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Target Digest",
          "type": "string"
        },
        "target_ref": {
          "minLength": 1,
          "title": "Target Ref",
          "type": "string"
        }
      },
      "required": [
        "event_id",
        "subject_id",
        "event_type",
        "target_ref",
        "target_digest",
        "decision",
        "reason",
        "policy_version",
        "occurred_at",
        "signature"
      ],
      "title": "GovernanceEvent",
      "type": "object"
    },
    "GovernanceEventType": {
      "enum": [
        "review_decision",
        "release_decision",
        "activation_decision",
        "custody_action"
      ],
      "title": "GovernanceEventType",
      "type": "string"
    },
    "RuntimeLearningAssessment": {
      "additionalProperties": false,
      "description": "Append-only classification used to measure false or missed automatic learning.",
      "properties": {
        "assessment_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Assessment Id",
          "type": "string"
        },
        "assessment_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Assessment Version",
          "type": "string"
        },
        "cycle_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Cycle Digest",
          "type": "string"
        },
        "cycle_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Cycle Id",
          "type": "string"
        },
        "outcome": {
          "$ref": "#/$defs/RuntimeLearningAssessmentOutcome"
        },
        "recorded_at": {
          "format": "date-time",
          "title": "Recorded At",
          "type": "string"
        },
        "subject_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Subject Id",
          "type": "string"
        }
      },
      "required": [
        "assessment_id",
        "subject_id",
        "cycle_id",
        "cycle_digest",
        "outcome",
        "recorded_at"
      ],
      "title": "RuntimeLearningAssessment",
      "type": "object"
    },
    "RuntimeLearningAssessmentOutcome": {
      "description": "Owner/evaluator classification of one exact automatic learning decision.",
      "enum": [
        "correct",
        "false_positive",
        "missed"
      ],
      "title": "RuntimeLearningAssessmentOutcome",
      "type": "string"
    },
    "RuntimeReviewScopeRefinement": {
      "additionalProperties": false,
      "description": "Owner-authored narrowing of one immutable review proposal.\n\nThe source proposal remains unchanged. The refinement binds the original queue and detection,\nrecords the exact narrower scope, and names the newly evaluated detection that may be promoted.",
      "properties": {
        "original_detection_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Original Detection Digest",
          "type": "string"
        },
        "original_scope": {
          "$ref": "#/$defs/Scope"
        },
        "queue_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Queue Digest",
          "type": "string"
        },
        "queue_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Queue Id",
          "type": "string"
        },
        "raw_payload_exposed": {
          "const": false,
          "default": false,
          "title": "Raw Payload Exposed",
          "type": "boolean"
        },
        "refined_at": {
          "format": "date-time",
          "title": "Refined At",
          "type": "string"
        },
        "refined_detection_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Refined Detection Digest",
          "type": "string"
        },
        "refined_layer": {
          "$ref": "#/$defs/AdaptationLayer"
        },
        "refined_scope": {
          "$ref": "#/$defs/Scope"
        },
        "refinement_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Refinement Id",
          "type": "string"
        },
        "refinement_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Refinement Version",
          "type": "string"
        }
      },
      "required": [
        "refinement_id",
        "queue_id",
        "queue_digest",
        "original_detection_digest",
        "refined_detection_digest",
        "original_scope",
        "refined_scope",
        "refined_layer",
        "refined_at"
      ],
      "title": "RuntimeReviewScopeRefinement",
      "type": "object"
    },
    "Scope": {
      "additionalProperties": false,
      "description": "Machine-comparable applicability bounds.\n\nEmpty optional dimensions mean unconstrained. Subjects are never unconstrained in this\nsingle-user prototype. A narrower scope may restrict a dimension, add exclusions or\nactivation conditions, and shrink the validity window.",
      "properties": {
        "activation_conditions": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Activation Conditions",
          "type": "array"
        },
        "environment_ids": {
          "default": [],
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Environment Ids",
          "type": "array"
        },
        "exclusions": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Exclusions",
          "type": "array"
        },
        "project_ids": {
          "default": [],
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Project Ids",
          "type": "array"
        },
        "repository_ids": {
          "default": [],
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Repository Ids",
          "type": "array"
        },
        "subject_ids": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Subject Ids",
          "type": "array"
        },
        "target_families": {
          "default": [],
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Target Families",
          "type": "array"
        },
        "task_classes": {
          "default": [],
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Task Classes",
          "type": "array"
        },
        "valid_from": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid From"
        },
        "valid_until": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid Until"
        },
        "workspace_ids": {
          "default": [],
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Workspace Ids",
          "type": "array"
        }
      },
      "required": [
        "subject_ids"
      ],
      "title": "Scope",
      "type": "object"
    },
    "SignatureEnvelope": {
      "additionalProperties": false,
      "description": "Detached Ed25519 signature metadata included in a signed object.",
      "properties": {
        "algorithm": {
          "const": "Ed25519",
          "default": "Ed25519",
          "title": "Algorithm",
          "type": "string"
        },
        "canonicalization_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Canonicalization Version",
          "type": "string"
        },
        "key_fingerprint": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Key Fingerprint",
          "type": "string"
        },
        "purpose": {
          "minLength": 1,
          "title": "Purpose",
          "type": "string"
        },
        "signature_base64": {
          "minLength": 1,
          "title": "Signature Base64",
          "type": "string"
        },
        "signed_at": {
          "format": "date-time",
          "title": "Signed At",
          "type": "string"
        },
        "signer_identity_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Signer Identity Id",
          "type": "string"
        }
      },
      "required": [
        "signer_identity_id",
        "key_fingerprint",
        "purpose",
        "signed_at",
        "signature_base64"
      ],
      "title": "SignatureEnvelope",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Signed append-only owner decision for one exact inactive learning proposal.",
  "properties": {
    "assessment": {
      "$ref": "#/$defs/RuntimeLearningAssessment"
    },
    "cycle_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Cycle Digest",
      "type": "string"
    },
    "cycle_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Cycle Id",
      "type": "string"
    },
    "decision": {
      "$ref": "#/$defs/ApprovalDecision"
    },
    "evaluation_digest": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Evaluation Digest"
    },
    "prior_state_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Prior State Digest",
      "type": "string"
    },
    "queue_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Queue Digest",
      "type": "string"
    },
    "queue_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Queue Id",
      "type": "string"
    },
    "release_digest": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Release Digest"
    },
    "release_event_digest": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Release Event Digest"
    },
    "resolution_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Resolution Id",
      "type": "string"
    },
    "resolution_version": {
      "default": "1.0.0",
      "enum": [
        "1.0.0",
        "1.1.0"
      ],
      "title": "Resolution Version",
      "type": "string"
    },
    "resolved_at": {
      "format": "date-time",
      "title": "Resolved At",
      "type": "string"
    },
    "resulting_state_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Resulting State Digest",
      "type": "string"
    },
    "review": {
      "$ref": "#/$defs/Approval"
    },
    "review_event": {
      "$ref": "#/$defs/GovernanceEvent"
    },
    "scope_refinement": {
      "anyOf": [
        {
          "$ref": "#/$defs/RuntimeReviewScopeRefinement"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "subject_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Subject Id",
      "type": "string"
    },
    "transition_digest": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Transition Digest"
    }
  },
  "required": [
    "resolution_id",
    "queue_id",
    "queue_digest",
    "subject_id",
    "cycle_id",
    "cycle_digest",
    "decision",
    "review",
    "review_event",
    "assessment",
    "prior_state_digest",
    "resulting_state_digest",
    "resolved_at"
  ],
  "title": "RuntimeLearningReviewResolution",
  "type": "object"
}
