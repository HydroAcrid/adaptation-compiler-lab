{
  "additionalProperties": false,
  "description": "Raw-free metadata for current Windows and macOS platform credential stores.",
  "properties": {
    "config_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Config Digest",
      "type": "string"
    },
    "enrolled_at": {
      "format": "date-time",
      "title": "Enrolled At",
      "type": "string"
    },
    "envelope_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Envelope Id",
      "type": "string"
    },
    "envelope_version": {
      "const": "1.1.0",
      "default": "1.1.0",
      "title": "Envelope Version",
      "type": "string"
    },
    "protected_payload_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Protected Payload Digest",
      "type": "string"
    },
    "protector": {
      "enum": [
        "windows-dpapi-current-user",
        "macos-keychain-security-framework"
      ],
      "title": "Protector",
      "type": "string"
    },
    "revoked_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Revoked At"
    },
    "signer_fingerprint": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Signer Fingerprint",
      "type": "string"
    },
    "subject_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Subject Id",
      "type": "string"
    }
  },
  "required": [
    "envelope_id",
    "subject_id",
    "config_digest",
    "signer_fingerprint",
    "protector",
    "protected_payload_digest",
    "enrolled_at"
  ],
  "title": "CredentialEnvelopeMetadataV1_1",
  "type": "object"
}
