      "type": "string"
    },
    "public_summary": {
      "title": "Public Summary",
      "type": "string"
    },
    "subject_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Subject Id",
      "type": "string"
    }
