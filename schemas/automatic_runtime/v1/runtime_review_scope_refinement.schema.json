{
  "$defs": {
    "AdaptationLayer": {
      "description": "Separately governed inputs combined by the future product runtime.",
      "enum": [
        "permanent_profile",
        "current_context",
        "temporary_capability_preset",
        "personal_preset_overlay"
      ],
      "title": "AdaptationLayer",
      "type": "string"
    },
    "Scope": {
      "additionalProperties": false,
      "description": "Machine-comparable applicability bounds.\n\nEmpty optional dimensions mean unconstrained. Subjects are never unconstrained in this\nsingle-user prototype. A narrower scope may restrict a dimension, add exclusions or\nactivation conditions, and shrink the validity window.",
      "properties": {
        "activation_conditions": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Activation Conditions",
          "type": "array"
        },
        "environment_ids": {
          "default": [],
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Environment Ids",
          "type": "array"
        },
        "exclusions": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Exclusions",
          "type": "array"
        },
        "project_ids": {
          "default": [],
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Project Ids",
          "type": "array"
        },
        "repository_ids": {
          "default": [],
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Repository Ids",
          "type": "array"
        },
        "subject_ids": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Subject Ids",
          "type": "array"
        },
        "target_families": {
          "default": [],
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Target Families",
          "type": "array"
        },
        "task_classes": {
          "default": [],
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Task Classes",
          "type": "array"
        },
        "valid_from": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid From"
        },
        "valid_until": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid Until"
        },
        "workspace_ids": {
          "default": [],
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Workspace Ids",
          "type": "array"
        }
      },
      "required": [
        "subject_ids"
      ],
      "title": "Scope",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Owner-authored narrowing of one immutable review proposal.\n\nThe source proposal remains unchanged. The refinement binds the original queue and detection,\nrecords the exact narrower scope, and names the newly evaluated detection that may be promoted.",
  "properties": {
    "original_detection_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Original Detection Digest",
      "type": "string"
    },
    "original_scope": {
      "$ref": "#/$defs/Scope"
    },
    "queue_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Queue Digest",
      "type": "string"
    },
    "queue_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Queue Id",
      "type": "string"
    },
    "raw_payload_exposed": {
      "const": false,
      "default": false,
      "title": "Raw Payload Exposed",
      "type": "boolean"
    },
    "refined_at": {
      "format": "date-time",
      "title": "Refined At",
      "type": "string"
    },
    "refined_detection_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Refined Detection Digest",
      "type": "string"
    },
    "refined_layer": {
      "$ref": "#/$defs/AdaptationLayer"
    },
    "refined_scope": {
      "$ref": "#/$defs/Scope"
    },
    "refinement_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Refinement Id",
      "type": "string"
    },
    "refinement_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Refinement Version",
      "type": "string"
    }
  },
  "required": [
    "refinement_id",
    "queue_id",
    "queue_digest",
    "original_detection_digest",
    "refined_detection_digest",
    "original_scope",
    "refined_scope",
    "refined_layer",
    "refined_at"
  ],
  "title": "RuntimeReviewScopeRefinement",
  "type": "object"
}
