{
  "additionalProperties": false,
  "properties": {
    "acquired_at": {
      "format": "date-time",
      "title": "Acquired At",
      "type": "string"
    },
    "baseline_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Baseline Digest",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "lease_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Lease Id",
      "type": "string"
    },
    "session_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Session Id",
      "type": "string"
    },
    "workspace_root_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Workspace Root Digest",
      "type": "string"
    }
  },
  "required": [
    "lease_id",
    "session_id",
    "baseline_digest",
    "workspace_root_digest",
    "acquired_at",
    "expires_at"
  ],
  "title": "WorkspaceLease",
  "type": "object"
}
