{
  "$defs": {
    "SemanticStimulationSliceMetrics": {
      "additionalProperties": false,
      "description": "Detection, routing, and scope metrics for one controlled slice.",
      "properties": {
        "case_count": {
          "minimum": 1,
          "title": "Case Count",
          "type": "integer"
        },
        "detection_accuracy": {
          "maximum": 1,
          "minimum": 0,
          "title": "Detection Accuracy",
          "type": "number"
        },
        "dimension": {
          "enum": [
            "context",
            "semantic_class",
            "split",
            "style",
            "turn"
          ],
          "title": "Dimension",
          "type": "string"
        },
        "expected_negative": {
          "minimum": 0,
          "title": "Expected Negative",
          "type": "integer"
        },
        "expected_positive": {
          "minimum": 0,
          "title": "Expected Positive",
          "type": "integer"
        },
        "false_negative": {
          "minimum": 0,
          "title": "False Negative",
          "type": "integer"
        },
        "false_positive": {
          "minimum": 0,
          "title": "False Positive",
          "type": "integer"
        },
        "negative_specificity": {
          "maximum": 1,
          "minimum": 0,
          "title": "Negative Specificity",
          "type": "number"
        },
        "precision": {
          "maximum": 1,
          "minimum": 0,
          "title": "Precision",
          "type": "number"
        },
        "recall": {
          "maximum": 1,
          "minimum": 0,
          "title": "Recall",
          "type": "number"
        },
        "route_accuracy": {
          "maximum": 1,
          "minimum": 0,
          "title": "Route Accuracy",
          "type": "number"
        },
        "scope_accuracy": {
          "maximum": 1,
          "minimum": 0,
          "title": "Scope Accuracy",
          "type": "number"
        },
        "slice_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Slice Id",
          "type": "string"
        },
        "true_negative": {
          "minimum": 0,
          "title": "True Negative",
          "type": "integer"
        },
        "true_positive": {
          "minimum": 0,
          "title": "True Positive",
          "type": "integer"
        }
      },
      "required": [
        "dimension",
        "slice_id",
        "case_count",
        "expected_positive",
        "expected_negative",
        "true_positive",
        "false_positive",
        "true_negative",
        "false_negative",
        "detection_accuracy",
        "precision",
        "recall",
        "negative_specificity",
        "route_accuracy",
        "scope_accuracy"
      ],
      "title": "SemanticStimulationSliceMetrics",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Raw-free diagnostic result; never a production-promotion receipt.",
  "properties": {
    "audit_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Audit Digest",
      "type": "string"
    },
    "calibration_report_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Calibration Report Digest",
      "type": "string"
    },
    "case_count": {
      "const": 100,
      "default": 100,
      "title": "Case Count",
      "type": "integer"
    },
    "corpus_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Corpus Digest",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "detector_gate_passed": {
      "title": "Detector Gate Passed",
      "type": "boolean"
    },
    "failed_case_ids": {
      "items": {
        "maxLength": 200,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
        "type": "string"
      },
      "title": "Failed Case Ids",
      "type": "array"
    },
    "generation_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Generation Digest",
      "type": "string"
    },
    "holdout_report_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Holdout Report Digest",
      "type": "string"
    },
    "plan_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Plan Digest",
      "type": "string"
    },
    "production_promotion_permitted": {
      "const": false,
      "default": false,
      "title": "Production Promotion Permitted",
      "type": "boolean"
    },
    "production_state_mutated": {
      "const": false,
      "default": false,
      "title": "Production State Mutated",
      "type": "boolean"
    },
    "protocol_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Protocol Digest",
      "type": "string"
    },
    "slices": {
      "items": {
        "$ref": "#/$defs/SemanticStimulationSliceMetrics"
      },
      "title": "Slices",
      "type": "array"
    },
    "summary_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Summary Version",
      "type": "string"
    },
    "synthetic_is_user_authority": {
      "const": false,
      "default": false,
      "title": "Synthetic Is User Authority",
      "type": "boolean"
    },
    "synthetic_only": {
      "const": true,
      "default": true,
      "title": "Synthetic Only",
      "type": "boolean"
    }
  },
  "required": [
    "created_at",
    "protocol_digest",
    "plan_digest",
    "generation_digest",
    "audit_digest",
    "corpus_digest",
    "calibration_report_digest",
    "holdout_report_digest",
    "detector_gate_passed",
    "slices",
    "failed_case_ids"
  ],
  "title": "SemanticStimulationSummary",
  "type": "object"
}
