{
  "$defs": {
    "SemanticFeatureBlindEntry": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Case Id"
        },
        "case_index": {
          "anyOf": [
            {
              "maximum": 63,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Case Index"
        },
        "classification": {
          "$ref": "#/$defs/SemanticFeatureClass"
        },
        "scope_hint": {
          "$ref": "#/$defs/SemanticScopeHint"
        }
      },
      "required": [
        "classification",
        "scope_hint"
      ],
      "title": "SemanticFeatureBlindEntry",
      "type": "object"
    },
    "SemanticFeatureClass": {
      "enum": [
        "memory",
        "preference",
        "procedure",
        "prompt_rule",
        "positive_example",
        "revocation",
        "correction",
        "ambiguous"
      ],
      "title": "SemanticFeatureClass",
      "type": "string"
    },
    "SemanticScopeHint": {
      "description": "Non-authoritative scope hint emitted by semantic interpretation.",
      "enum": [
        "permanent_profile",
        "current_context"
      ],
      "title": "SemanticScopeHint",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "audit_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Audit Version",
      "type": "string"
    },
    "auditor_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Auditor Id",
      "type": "string"
    },
    "entries": {
      "items": {
        "$ref": "#/$defs/SemanticFeatureBlindEntry"
      },
      "maxItems": 64,
      "minItems": 64,
      "title": "Entries",
      "type": "array"
    },
    "generation_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Generation Digest",
      "type": "string"
    }
  },
  "required": [
    "auditor_id",
    "generation_digest",
    "entries"
  ],
  "title": "SemanticFeatureBlindAudit",
  "type": "object"
}
