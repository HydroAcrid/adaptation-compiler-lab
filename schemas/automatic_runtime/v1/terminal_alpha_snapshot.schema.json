        },
        "false_activation_count": {
          "minimum": 0,
          "title": "False Activation Count",
          "type": "integer"
        },
        "false_learning_count": {
          "minimum": 0,
          "title": "False Learning Count",
          "type": "integer"
        },
        "generated_at": {
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        },
        "goal_interaction_count": {
          "minimum": 1,
          "title": "Goal Interaction Count",
          "type": "integer"
        },
        "helped_count": {
          "minimum": 0,
          "title": "Helped Count",
          "type": "integer"
        },
        "hurt_count": {
          "minimum": 0,
          "title": "Hurt Count",
          "type": "integer"
        },
        "irrelevant_count": {
          "minimum": 0,
          "title": "Irrelevant Count",
          "type": "integer"
        },
        "manual_review_touches": {
          "minimum": 0,
          "title": "Manual Review Touches",
          "type": "integer"
        },
        "minimum_activation_count": {
          "minimum": 1,
          "title": "Minimum Activation Count",
          "type": "integer"
        },
        "minimum_active_dates": {
          "minimum": 1,
          "title": "Minimum Active Dates",
          "type": "integer"
        },
        "missed_activation_count": {
          "minimum": 0,
          "title": "Missed Activation Count",
          "type": "integer"
        },
        "missed_learning_count": {
          "minimum": 0,
          "title": "Missed Learning Count",
          "type": "integer"
        },
        "no_explicit_signal_count": {
          "minimum": 0,
          "title": "No Explicit Signal Count",
          "type": "integer"
        },
        "pack_bytes_by_activation": {
          "items": {
            "type": "integer"
          },
          "title": "Pack Bytes By Activation",
          "type": "array"
        },
        "promoted_count": {
          "minimum": 0,
          "title": "Promoted Count",
          "type": "integer"
        },
        "rated_activation_count": {
          "minimum": 0,
          "title": "Rated Activation Count",
          "type": "integer"
        },
        "rejected_review_count": {
          "minimum": 0,
          "title": "Rejected Review Count",
          "type": "integer"
        },
        "remaining_interactions": {
          "minimum": 0,
          "title": "Remaining Interactions",
          "type": "integer"
        },
        "repeated_correction_count": {
          "minimum": 0,
          "title": "Repeated Correction Count",
          "type": "integer"
        },
        "report_version": {
          "const": "1.1.0",
          "default": "1.1.0",
          "title": "Report Version",
          "type": "string"
        },
        "resolved_review_count": {
          "minimum": 0,
          "title": "Resolved Review Count",
          "type": "integer"
        },
        "review_required_count": {
          "minimum": 0,
          "title": "Review Required Count",
          "type": "integer"
        },
        "revoked_count": {
          "minimum": 0,
          "title": "Revoked Count",
          "type": "integer"
        },
        "subject_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Subject Id",
          "type": "string"
        },
        "unresolved_activation_count": {
          "minimum": 0,
          "title": "Unresolved Activation Count",
          "type": "integer"
        },
        "unresolved_review_count": {
          "minimum": 0,
          "title": "Unresolved Review Count",
          "type": "integer"
        },
        "update_latency_seconds": {
          "items": {
            "type": "number"
          },
          "title": "Update Latency Seconds",
          "type": "array"
        }
      },
      "required": [
        "subject_id",
        "generated_at",
        "goal_interaction_count",
        "minimum_active_dates",
        "minimum_activation_count",
        "eligible_interaction_count",
        "active_date_count",
        "assessed_interaction_count",
        "correct_learning_count",
        "false_learning_count",
        "missed_learning_count",
        "promoted_count",
        "revoked_count",
        "review_required_count",
        "resolved_review_count",
        "approved_review_count",
        "rejected_review_count",
        "unresolved_review_count",
        "blocked_count",
        "no_explicit_signal_count",
        "duplicate_count",
        "activation_count",
        "completed_activation_count",
        "failed_activation_count",
        "unresolved_activation_count",
        "rated_activation_count",
        "helped_count",
        "hurt_count",
        "irrelevant_count",
        "correct_activation_count",
        "false_activation_count",
        "missed_activation_count",
        "repeated_correction_count",
        "pack_bytes_by_activation",
        "update_latency_seconds",
        "automatic_actions",
        "manual_review_touches",
        "remaining_interactions",
        "evidence_ready"
      ],
      "title": "CodexDogfoodGateReport",
      "type": "object"
    },
    "ConsentReceiptRef": {
      "additionalProperties": false,
      "properties": {
        "content_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Digest",
          "type": "string"
        },
        "governance_type": {
          "const": "consent_receipt",
          "default": "consent_receipt",
          "title": "Governance Type",
          "type": "string"
        },
        "object_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Object Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "object_id",
        "content_digest"
      ],
      "title": "ConsentReceiptRef",
      "type": "object"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "content_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Digest",
          "type": "string"
        },
        "record_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Record Id",
          "type": "string"
        },
        "record_type": {
          "const": "evidence",
          "default": "evidence",
          "title": "Record Type",
          "type": "string"
        },
        "record_version": {
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$",
          "title": "Record Version",
          "type": "string"
        }
      },
      "required": [
        "record_id",
        "record_version",
        "content_digest"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "FeedbackDetectorMode": {
      "description": "Serving mode for the semantic feedback interpreter.",
      "enum": [
        "grammar",
        "shadow",
        "review",
        "calibrated"
      ],
      "title": "FeedbackDetectorMode",
      "type": "string"
    },
    "FeedbackSignalKind": {
      "description": "User signals that may become governed adaptation candidates.",
      "enum": [
        "memory",
        "preference",
        "procedure",
        "prompt_rule",
        "positive_example",
        "correction",
        "revocation"
      ],
      "title": "FeedbackSignalKind",
      "type": "string"
    },
    "GateAllowanceCard": {
      "additionalProperties": false,
      "description": "One frozen error allowance rendered without implying that readiness means success.",
      "properties": {
        "maximum": {
          "const": 1,
          "default": 1,
          "title": "Maximum",
          "type": "integer"
        },
        "name": {
          "enum": [
            "missed_learning",
            "false_learning",
            "false_activation"
          ],
          "title": "Name",
          "type": "string"
        },
        "observed": {
          "minimum": 0,
          "title": "Observed",
          "type": "integer"
        },
        "state": {
          "enum": [
            "available",
            "used",
            "exceeded"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "name",
        "observed",
        "state"
      ],
      "title": "GateAllowanceCard",
      "type": "object"
    },
    "ReviewModeDogfoodMetrics": {
      "additionalProperties": false,
      "description": "Product-friction measures not already represented by the frozen 6A.2C gate.",
      "properties": {
        "activation_feedback_latency_seconds": {
          "items": {
            "type": "number"
          },
          "title": "Activation Feedback Latency Seconds",
          "type": "array"
        },
        "pending_feedback_count": {
          "minimum": 0,
          "title": "Pending Feedback Count",
          "type": "integer"
        },
        "pending_review_age_seconds": {
          "items": {
            "type": "number"
          },
          "title": "Pending Review Age Seconds",
          "type": "array"
        },
        "pending_review_count": {
          "minimum": 0,
          "title": "Pending Review Count",
          "type": "integer"
        },
        "resolved_review_count": {
          "minimum": 0,
          "title": "Resolved Review Count",
          "type": "integer"
        },
        "review_decision_latency_seconds": {
          "items": {
            "type": "number"
          },
          "title": "Review Decision Latency Seconds",
          "type": "array"
        },
        "scope_refinement_count": {
          "minimum": 0,
          "title": "Scope Refinement Count",
          "type": "integer"
        }
      },
      "required": [
        "resolved_review_count",
        "scope_refinement_count",
        "pending_review_count",
        "pending_feedback_count",
        "review_decision_latency_seconds",
        "pending_review_age_seconds",
        "activation_feedback_latency_seconds"
      ],
      "title": "ReviewModeDogfoodMetrics",
      "type": "object"
    },
    "ReviewModeDogfoodSnapshot": {
      "additionalProperties": false,
      "description": "Single actionable daily view over the governed automatic-runtime ledgers.",
      "properties": {
        "activation_feedback": {
          "items": {
            "$ref": "#/$defs/ActivationFeedbackCard"
          },
          "title": "Activation Feedback",
          "type": "array"
        },
        "active_artifact_count": {
          "minimum": 0,
          "title": "Active Artifact Count",
          "type": "integer"
        },
        "automatic_promotion_enabled": {
          "const": false,
          "default": false,
          "title": "Automatic Promotion Enabled",
          "type": "boolean"
        },
        "credential_enrolled": {
          "title": "Credential Enrolled",
          "type": "boolean"
        },
        "detector_mode": {
          "$ref": "#/$defs/FeedbackDetectorMode"
        },
        "gate": {
          "$ref": "#/$defs/CodexDogfoodGateReport"
        },
        "generated_at": {
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        },
        "generation": {
          "minimum": 0,
          "title": "Generation",
          "type": "integer"
        },
        "metrics": {
          "$ref": "#/$defs/ReviewModeDogfoodMetrics"
        },
        "naming_status": {
          "const": "internal_working_name",
          "default": "internal_working_name",
