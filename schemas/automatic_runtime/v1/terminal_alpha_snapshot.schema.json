{
  "$defs": {
    "ActivationFeedbackCard": {
      "additionalProperties": false,
      "description": "One completed activation waiting for helped/hurt/irrelevant owner feedback.",
      "properties": {
        "activated_at": {
          "format": "date-time",
          "title": "Activated At",
          "type": "string"
        },
        "activation_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Activation Id",
          "type": "string"
        },
        "active_artifact_ids": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Active Artifact Ids",
          "type": "array"
        },
        "available_actions": {
          "default": [
            "helped",
            "hurt",
            "irrelevant"
          ],
          "items": {
            "enum": [
              "helped",
              "hurt",
              "irrelevant"
            ],
            "type": "string"
          },
          "title": "Available Actions",
          "type": "array"
        },
        "card_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Card Version",
          "type": "string"
        },
        "completed_at": {
          "format": "date-time",
          "title": "Completed At",
          "type": "string"
        },
        "delivery_receipt_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Delivery Receipt Digest",
          "type": "string"
        },
        "projection_utf8_bytes": {
          "minimum": 0,
          "title": "Projection Utf8 Bytes",
          "type": "integer"
        },
        "raw_payload_exposed": {
          "const": false,
          "default": false,
          "title": "Raw Payload Exposed",
          "type": "boolean"
        },
        "task_ref_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Task Ref Id",
          "type": "string"
        }
      },
      "required": [
        "activation_id",
        "task_ref_id",
        "delivery_receipt_digest",
        "active_artifact_ids",
        "projection_utf8_bytes",
        "activated_at",
        "completed_at"
      ],
      "title": "ActivationFeedbackCard",
      "type": "object"
    },
    "ActiveAdaptationCard": {
      "additionalProperties": false,
      "description": "Raw-free behavior and governance summary for one active artifact.",
      "properties": {
        "artifact_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_type": {
          "minLength": 1,
          "title": "Artifact Type",
          "type": "string"
        },
        "artifact_version": {
          "minLength": 1,
          "title": "Artifact Version",
          "type": "string"
        },
        "card_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Card Version",
          "type": "string"
        },
        "evidence_count": {
          "minimum": 1,
          "title": "Evidence Count",
          "type": "integer"
        },
        "expires_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expires At"
        },
        "intent": {
          "minLength": 1,
          "title": "Intent",
          "type": "string"
        },
        "layer": {
          "$ref": "#/$defs/AdaptationLayer"
        },
        "raw_payload_exposed": {
          "const": false,
          "default": false,
          "title": "Raw Payload Exposed",
          "type": "boolean"
        },
        "required_behaviors": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Required Behaviors",
          "type": "array"
        },
        "review_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Review At"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        }
      },
      "required": [
        "artifact_id",
        "artifact_version",
        "artifact_type",
        "layer",
        "intent",
        "required_behaviors",
        "scope",
        "evidence_count"
      ],
      "title": "ActiveAdaptationCard",
      "type": "object"
    },
    "AdaptationLayer": {
      "description": "Separately governed inputs combined by the future product runtime.",
      "enum": [
        "permanent_profile",
        "current_context",
        "temporary_capability_preset",
        "personal_preset_overlay"
      ],
      "title": "AdaptationLayer",
      "type": "string"
    },
    "ArtifactRoute": {
      "enum": [
        "evaluation_only",
        "memory",
        "preference",
        "example",
        "procedure",
        "prompt_rule",
        "skill",
        "tool_recommendation",
        "inactive_tool_candidate",
        "inactive_adapter_dataset_candidate"
      ],
      "title": "ArtifactRoute",
      "type": "string"
    },
    "CaptureReceiptRef": {
      "additionalProperties": false,
      "properties": {
        "content_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Digest",
          "type": "string"
        },
        "governance_type": {
          "const": "capture_receipt",
          "default": "capture_receipt",
          "title": "Governance Type",
          "type": "string"
        },
        "object_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Object Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "object_id",
        "content_digest"
      ],
      "title": "CaptureReceiptRef",
      "type": "object"
    },
    "CodexDogfoodGateReport": {
