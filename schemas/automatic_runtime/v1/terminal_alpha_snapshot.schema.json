          "type": "string"
        },
        "next_actions": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Next Actions",
          "type": "array"
        },
        "proposals": {
          "items": {
            "$ref": "#/$defs/ReviewProposalCard"
          },
          "title": "Proposals",
          "type": "array"
        },
        "raw_payloads_exposed": {
          "const": false,
          "default": false,
          "title": "Raw Payloads Exposed",
          "type": "boolean"
        },
        "recent_notices": {
          "items": {
            "$ref": "#/$defs/RuntimeNotice"
          },
          "title": "Recent Notices",
          "type": "array"
        },
        "snapshot_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Snapshot Version",
          "type": "string"
        },
        "subject_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Subject Id",
          "type": "string"
        },
        "watcher_active": {
          "title": "Watcher Active",
          "type": "boolean"
        },
        "working_product_name": {
          "const": "Temper",
          "default": "Temper",
          "title": "Working Product Name",
          "type": "string"
        }
      },
      "required": [
        "subject_id",
        "generated_at",
        "detector_mode",
        "credential_enrolled",
        "watcher_active",
        "generation",
        "active_artifact_count",
        "proposals",
        "activation_feedback",
        "recent_notices",
        "metrics",
        "gate",
        "next_actions"
      ],
      "title": "ReviewModeDogfoodSnapshot",
      "type": "object"
    },
    "ReviewProposalCard": {
      "additionalProperties": false,
      "description": "Compact proposal and exact lineage shown to the owner, never supporting raw text.",
      "properties": {
        "affected_artifact_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Affected Artifact Id"
        },
        "available_actions": {
          "items": {
            "enum": [
              "approve",
              "reject",
              "refine_scope"
            ],
            "type": "string"
          },
          "title": "Available Actions",
          "type": "array"
        },
        "behavior": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Behavior"
        },
        "capture_ref": {
          "$ref": "#/$defs/CaptureReceiptRef"
        },
        "card_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Card Version",
          "type": "string"
        },
        "consent_ref": {
          "$ref": "#/$defs/ConsentReceiptRef"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "cycle_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Cycle Id",
          "type": "string"
        },
        "evidence_ref": {
          "$ref": "#/$defs/EvidenceRef"
        },
        "layer": {
          "$ref": "#/$defs/AdaptationLayer"
        },
        "proposal_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Proposal Digest",
          "type": "string"
        },
        "queue_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Queue Id",
          "type": "string"
        },
        "raw_payload_exposed": {
          "const": false,
          "default": false,
          "title": "Raw Payload Exposed",
          "type": "boolean"
