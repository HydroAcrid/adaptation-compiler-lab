{
  "additionalProperties": false,
  "properties": {
    "argv_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Argv Digest",
      "type": "string"
    },
    "command_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Command Id",
      "type": "string"
    },
    "completed_at": {
      "format": "date-time",
      "title": "Completed At",
      "type": "string"
    },
    "exit_code": {
      "title": "Exit Code",
      "type": "integer"
    },
    "output_bytes": {
      "minimum": 0,
      "title": "Output Bytes",
      "type": "integer"
    },
    "output_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Output Digest",
      "type": "string"
    },
    "receipt_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Receipt Id",
      "type": "string"
    },
    "session_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Session Id",
      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "timed_out": {
      "title": "Timed Out",
      "type": "boolean"
    }
  },
  "required": [
    "receipt_id",
    "session_id",
    "command_id",
    "argv_digest",
    "exit_code",
    "timed_out",
    "output_digest",
    "output_bytes",
    "started_at",
    "completed_at"
  ],
  "title": "VerificationReceipt",
  "type": "object"
}
