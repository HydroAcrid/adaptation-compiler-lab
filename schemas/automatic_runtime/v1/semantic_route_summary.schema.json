{
  "$defs": {
    "SemanticRouteBlindMetrics": {
      "additionalProperties": false,
      "description": "Agreement of two label-blind auditors with the frozen answer key.",
      "properties": {
        "ambiguous_case_ids": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Ambiguous Case Ids",
          "type": "array"
        },
        "auditor_a_label_accuracy": {
          "maximum": 1,
          "minimum": 0,
          "title": "Auditor A Label Accuracy",
          "type": "number"
        },
        "auditor_a_scope_accuracy": {
          "maximum": 1,
          "minimum": 0,
          "title": "Auditor A Scope Accuracy",
          "type": "number"
        },
        "auditor_b_label_accuracy": {
          "maximum": 1,
          "minimum": 0,
          "title": "Auditor B Label Accuracy",
          "type": "number"
        },
        "auditor_b_scope_accuracy": {
          "maximum": 1,
          "minimum": 0,
          "title": "Auditor B Scope Accuracy",
          "type": "number"
        },
        "both_match_answer_key_count": {
          "maximum": 120,
          "minimum": 0,
          "title": "Both Match Answer Key Count",
          "type": "integer"
        },
        "case_count": {
          "const": 120,
          "default": 120,
          "title": "Case Count",
          "type": "integer"
        },
        "pair_label_agreement": {
          "maximum": 1,
          "minimum": 0,
          "title": "Pair Label Agreement",
          "type": "number"
        },
        "pair_scope_agreement": {
          "maximum": 1,
          "minimum": 0,
          "title": "Pair Scope Agreement",
          "type": "number"
        }
      },
      "required": [
        "auditor_a_label_accuracy",
        "auditor_b_label_accuracy",
        "auditor_a_scope_accuracy",
        "auditor_b_scope_accuracy",
        "pair_label_agreement",
        "pair_scope_agreement",
        "both_match_answer_key_count",
        "ambiguous_case_ids"
      ],
      "title": "SemanticRouteBlindMetrics",
      "type": "object"
    },
    "SemanticRouteClass": {
      "description": "Mutually exclusive semantic forms under test.",
      "enum": [
        "memory",
        "positive_example",
        "preference",
        "procedure",
        "prompt_rule",
        "revocation"
      ],
      "title": "SemanticRouteClass",
      "type": "string"
    },
    "SemanticRouteClassMetrics": {
      "additionalProperties": false,
      "description": "Exact route and scope measurements for one semantic class.",
      "properties": {
        "case_count": {
          "minimum": 1,
          "title": "Case Count",
          "type": "integer"
        },
        "detected_count": {
          "minimum": 0,
          "title": "Detected Count",
          "type": "integer"
        },
        "detection_accuracy": {
          "maximum": 1,
          "minimum": 0,
          "title": "Detection Accuracy",
          "type": "number"
        },
        "exact_route_count": {
          "minimum": 0,
          "title": "Exact Route Count",
          "type": "integer"
        },
        "exact_scope_count": {
          "minimum": 0,
          "title": "Exact Scope Count",
          "type": "integer"
        },
        "route_accuracy": {
          "maximum": 1,
          "minimum": 0,
          "title": "Route Accuracy",
          "type": "number"
        },
        "scope_accuracy": {
          "maximum": 1,
          "minimum": 0,
          "title": "Scope Accuracy",
          "type": "number"
        },
        "semantic_class": {
          "$ref": "#/$defs/SemanticRouteClass"
        },
        "split": {
          "enum": [
            "calibration",
            "holdout",
            "combined"
          ],
          "title": "Split",
          "type": "string"
        }
      },
      "required": [
        "split",
        "semantic_class",
        "case_count",
        "detected_count",
        "exact_route_count",
        "exact_scope_count",
        "detection_accuracy",
        "route_accuracy",
        "scope_accuracy"
      ],
      "title": "SemanticRouteClassMetrics",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Raw-free result that cannot authorize production promotion.",
  "properties": {
    "auditor_a_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Auditor A Digest",
      "type": "string"
    },
    "auditor_b_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Auditor B Digest",
      "type": "string"
    },
    "blind_metrics": {
      "$ref": "#/$defs/SemanticRouteBlindMetrics"
    },
    "calibration_report_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Calibration Report Digest",
      "type": "string"
    },
    "class_metrics": {
      "items": {
        "$ref": "#/$defs/SemanticRouteClassMetrics"
      },
      "title": "Class Metrics",
      "type": "array"
    },
    "corpus_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Corpus Digest",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "failed_case_ids": {
      "items": {
        "maxLength": 200,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
        "type": "string"
      },
      "title": "Failed Case Ids",
      "type": "array"
    },
    "generation_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Generation Digest",
      "type": "string"
    },
    "holdout_report_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Holdout Report Digest",
      "type": "string"
    },
    "plan_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Plan Digest",
      "type": "string"
    },
    "production_promotion_authorized": {
      "const": false,
      "default": false,
      "title": "Production Promotion Authorized",
      "type": "boolean"
    },
    "production_state_mutated": {
      "const": false,
      "default": false,
      "title": "Production State Mutated",
      "type": "boolean"
    },
    "protocol_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Protocol Digest",
      "type": "string"
    },
    "route_gate_passed": {
      "title": "Route Gate Passed",
      "type": "boolean"
    },
    "summary_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Summary Version",
      "type": "string"
    },
    "synthetic_is_user_authority": {
      "const": false,
      "default": false,
      "title": "Synthetic Is User Authority",
      "type": "boolean"
    },
    "synthetic_only": {
      "const": true,
      "default": true,
      "title": "Synthetic Only",
      "type": "boolean"
    }
  },
  "required": [
    "created_at",
    "protocol_digest",
    "plan_digest",
    "generation_digest",
    "corpus_digest",
    "auditor_a_digest",
    "auditor_b_digest",
    "calibration_report_digest",
    "holdout_report_digest",
    "blind_metrics",
    "class_metrics",
    "route_gate_passed",
    "failed_case_ids"
  ],
  "title": "SemanticRouteSummary",
  "type": "object"
}
