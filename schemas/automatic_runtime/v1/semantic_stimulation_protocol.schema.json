{
  "$defs": {
    "RepositoryArchetypeReceipt": {
      "additionalProperties": false,
      "description": "Raw-free binding to one externally retained repository archetype.",
      "properties": {
        "archetype_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Archetype Digest",
          "type": "string"
        },
        "context_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Context Id",
          "type": "string"
        },
        "raw_repository_content_retained": {
          "const": false,
          "default": false,
          "title": "Raw Repository Content Retained",
          "type": "boolean"
        },
        "source_access": {
          "const": "read_only",
          "default": "read_only",
          "title": "Source Access",
          "type": "string"
        },
        "source_write_permitted": {
          "const": false,
          "default": false,
          "title": "Source Write Permitted",
          "type": "boolean"
        }
      },
      "required": [
        "context_id",
        "archetype_digest"
      ],
      "title": "RepositoryArchetypeReceipt",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Fail-closed declaration separating synthetic stimulation from user learning.",
  "properties": {
    "archetypes": {
      "items": {
        "$ref": "#/$defs/RepositoryArchetypeReceipt"
      },
      "maxItems": 5,
      "minItems": 5,
      "title": "Archetypes",
      "type": "array"
    },
    "audit_model": {
      "const": "gpt-5.6-luna",
      "default": "gpt-5.6-luna",
      "title": "Audit Model",
      "type": "string"
    },
    "audit_reasoning_effort": {
      "const": "low",
      "default": "low",
      "title": "Audit Reasoning Effort",
      "type": "string"
    },
    "authentication": {
      "const": "saved_chatgpt_subscription",
      "default": "saved_chatgpt_subscription",
      "title": "Authentication",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "detector_model": {
      "const": "gpt-5.6-luna",
      "default": "gpt-5.6-luna",
      "title": "Detector Model",
      "type": "string"
    },
    "detector_reasoning_effort": {
      "const": "medium",
      "default": "medium",
      "title": "Detector Reasoning Effort",
      "type": "string"
    },
    "generation_model": {
      "const": "gpt-5.6-luna",
      "default": "gpt-5.6-luna",
      "title": "Generation Model",
      "type": "string"
    },
    "generation_reasoning_effort": {
      "const": "low",
      "default": "low",
      "title": "Generation Reasoning Effort",
      "type": "string"
    },
    "plan_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Plan Digest",
      "type": "string"
    },
    "production_promotion_permitted": {
      "const": false,
      "default": false,
      "title": "Production Promotion Permitted",
      "type": "boolean"
    },
    "production_state_mutation_permitted": {
      "const": false,
      "default": false,
      "title": "Production State Mutation Permitted",
      "type": "boolean"
    },
    "protocol_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Protocol Id",
      "type": "string"
    },
    "protocol_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Protocol Version",
      "type": "string"
    },
    "provider_billed_cost_usd": {
      "const": 0,
      "default": 0,
      "title": "Provider Billed Cost Usd",
      "type": "integer"
    },
    "raw_repository_content_retained": {
      "const": false,
      "default": false,
      "title": "Raw Repository Content Retained",
      "type": "boolean"
    },
    "sealed_external_validation_access_permitted": {
      "const": false,
      "default": false,
      "title": "Sealed External Validation Access Permitted",
      "type": "boolean"
    },
    "source_access_mode": {
      "const": "read_only_privacy_minimized_archetypes",
      "title": "Source Access Mode",
      "type": "string"
    },
    "synthetic_is_user_authority": {
      "const": false,
      "default": false,
      "title": "Synthetic Is User Authority",
      "type": "boolean"
    },
    "synthetic_only": {
      "const": true,
      "default": true,
      "title": "Synthetic Only",
      "type": "boolean"
    }
  },
  "required": [
    "protocol_id",
    "created_at",
    "source_access_mode",
    "archetypes",
    "plan_digest"
  ],
  "title": "SemanticStimulationProtocol",
  "type": "object"
}
