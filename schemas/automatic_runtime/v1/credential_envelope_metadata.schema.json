{
  "additionalProperties": false,
  "properties": {
    "ciphertext_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Ciphertext Digest",
      "type": "string"
    },
    "config_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Config Digest",
      "type": "string"
    },
    "enrolled_at": {
      "format": "date-time",
      "title": "Enrolled At",
      "type": "string"
    },
    "envelope_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Envelope Id",
      "type": "string"
    },
    "envelope_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Envelope Version",
      "type": "string"
    },
    "protector": {
      "const": "windows-dpapi-current-user",
      "title": "Protector",
      "type": "string"
    },
    "revoked_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Revoked At"
    },
    "signer_fingerprint": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Signer Fingerprint",
      "type": "string"
    },
    "subject_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Subject Id",
      "type": "string"
    }
  },
  "required": [
    "envelope_id",
    "subject_id",
    "config_digest",
    "signer_fingerprint",
    "protector",
    "ciphertext_digest",
    "enrolled_at"
  ],
  "title": "CredentialEnvelopeMetadata",
  "type": "object"
}
