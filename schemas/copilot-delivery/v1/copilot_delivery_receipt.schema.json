{
  "$defs": {
    "SignatureEnvelope": {
      "additionalProperties": false,
      "description": "Detached Ed25519 signature metadata included in a signed object.",
      "properties": {
        "algorithm": {
          "const": "Ed25519",
          "default": "Ed25519",
          "title": "Algorithm",
          "type": "string"
        },
        "canonicalization_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Canonicalization Version",
          "type": "string"
        },
        "key_fingerprint": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Key Fingerprint",
          "type": "string"
        },
        "purpose": {
          "minLength": 1,
          "title": "Purpose",
          "type": "string"
        },
        "signature_base64": {
          "minLength": 1,
          "title": "Signature Base64",
          "type": "string"
        },
        "signed_at": {
          "format": "date-time",
          "title": "Signed At",
          "type": "string"
        },
        "signer_identity_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Signer Identity Id",
          "type": "string"
        }
      },
      "required": [
        "signer_identity_id",
        "key_fingerprint",
        "purpose",
        "signed_at",
        "signature_base64"
      ],
      "title": "SignatureEnvelope",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Signed raw-free record of one exact local projection delivery.",
  "properties": {
    "delivered_at": {
      "format": "date-time",
      "title": "Delivered At",
      "type": "string"
    },
    "instruction_environment_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Instruction Environment Digest",
      "type": "string"
    },
    "project_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Project Id",
      "type": "string"
    },
    "projection_lease_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Projection Lease Digest",
      "type": "string"
    },
    "prompt_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Prompt Digest",
      "type": "string"
    },
    "raw_payloads_stored": {
      "const": false,
      "default": false,
      "title": "Raw Payloads Stored",
      "type": "boolean"
    },
    "receipt_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Receipt Id",
      "type": "string"
    },
    "receipt_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Receipt Version",
      "type": "string"
    },
    "session_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Session Digest",
      "type": "string"
    },
    "signature": {
      "$ref": "#/$defs/SignatureEnvelope"
    },
    "subject_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Subject Id",
      "type": "string"
    },
    "transformed_prompt_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Transformed Prompt Digest",
      "type": "string"
    }
  },
  "required": [
    "receipt_id",
    "subject_id",
    "project_id",
    "session_digest",
    "prompt_digest",
    "transformed_prompt_digest",
    "projection_lease_digest",
    "instruction_environment_digest",
    "delivered_at",
    "signature"
  ],
  "title": "CopilotDeliveryReceiptV1",
  "type": "object"
}
