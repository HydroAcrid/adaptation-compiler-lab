      "const": "sha256:b9315df68cb0e2827c940ffacb66f7524e820d9744060c755fbf938724ad2b76",
      "default": "sha256:b9315df68cb0e2827c940ffacb66f7524e820d9744060c755fbf938724ad2b76",
      "title": "Target Cli Digest",
      "type": "string"
