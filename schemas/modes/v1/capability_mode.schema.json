{
  "$defs": {
    "ModeClause": {
      "additionalProperties": false,
      "description": "One compact default that may be suppressed by a higher-authority claim.",
      "properties": {
        "category": {
          "$ref": "#/$defs/ModeClauseCategory"
        },
        "claim_key": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Claim Key",
          "type": "string"
        },
        "clause_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Clause Id",
          "type": "string"
        },
        "source_component_ids": {
          "default": [],
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Source Component Ids",
          "type": "array"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "clause_id",
        "claim_key",
        "category",
        "text"
      ],
      "title": "ModeClause",
      "type": "object"
    },
    "ModeClauseCategory": {
      "description": "Bounded kinds of expertise a Mode may add to one task.",
      "enum": [
        "accessibility",
        "accuracy",
        "data_protection",
        "design_system",
        "evidence",
        "failure_handling",
        "responsive",
        "security",
        "threat_model",
        "validation",
        "visual_direction",
        "workflow"
      ],
      "title": "ModeClauseCategory",
      "type": "string"
    },
    "ModeEvaluationStatus": {
      "description": "Honest product status; conformance is not effectiveness evidence.",
      "enum": [
        "experimental",
        "curated_unproven",
        "failed",
        "product_evaluated",
        "revoked"
      ],
      "title": "ModeEvaluationStatus",
      "type": "string"
    },
    "ModeSecurityPosture": {
      "additionalProperties": false,
      "description": "Explicit capability posture; omission never grants ambient capability.",
      "properties": {
        "dependency_installation": {
          "const": "forbidden",
          "default": "forbidden",
          "title": "Dependency Installation",
          "type": "string"
        },
        "executable_content": {
          "const": "forbidden",
          "default": "forbidden",
          "title": "Executable Content",
          "type": "string"
        },
        "mcp_configuration": {
          "const": "forbidden",
          "default": "forbidden",
          "title": "Mcp Configuration",
          "type": "string"
        },
        "network_access": {
          "const": "not_requested",
          "default": "not_requested",
          "title": "Network Access",
          "type": "string"
        },
        "plugin_installation": {
          "const": "forbidden",
          "default": "forbidden",
          "title": "Plugin Installation",
          "type": "string"
        },
        "tool_installation": {
          "const": "forbidden",
          "default": "forbidden",
          "title": "Tool Installation",
          "type": "string"
        }
      },
      "title": "ModeSecurityPosture",
      "type": "object"
    },
    "ModeTargetCompatibility": {
      "additionalProperties": false,
      "description": "One version-pinned target surface for managed Mode delivery.",
      "properties": {
        "delivery_surface": {
          "minLength": 1,
          "title": "Delivery Surface",
          "type": "string"
        },
        "target_family": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Target Family",
          "type": "string"
        },
        "version_constraint": {
          "minLength": 1,
          "title": "Version Constraint",
          "type": "string"
        }
      },
      "required": [
        "target_family",
        "version_constraint",
        "delivery_surface"
      ],
      "title": "ModeTargetCompatibility",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Versioned first-party expertise kept separate from a user's permanent Core.",
  "properties": {
    "activation_default": {
      "const": "one_task",
      "default": "one_task",
      "title": "Activation Default",
      "type": "string"
    },
    "applicable_task_classes": {
      "items": {
        "maxLength": 200,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Applicable Task Classes",
      "type": "array"
    },
    "auto_activates": {
      "const": false,
      "default": false,
      "title": "Auto Activates",
      "type": "boolean"
    },
    "clauses": {
      "items": {
        "$ref": "#/$defs/ModeClause"
      },
      "minItems": 1,
      "title": "Clauses",
      "type": "array"
    },
    "compatible_target_families": {
      "items": {
        "maxLength": 200,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Compatible Target Families",
      "type": "array"
    },
    "evaluation_digest": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Evaluation Digest"
    },
    "evaluation_status": {
      "$ref": "#/$defs/ModeEvaluationStatus",
      "default": "experimental"
    },
    "maximum_projection_utf8_bytes": {
      "exclusiveMinimum": 0,
      "maximum": 12000,
      "title": "Maximum Projection Utf8 Bytes",
      "type": "integer"
    },
    "mode_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Mode Id",
      "type": "string"
    },
    "mode_schema_version": {
      "default": "1.1.0",
      "enum": [
        "1.0.0",
        "1.1.0",
        "1.2.0"
      ],
      "title": "Mode Schema Version",
      "type": "string"
    },
    "mode_version": {
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$",
      "title": "Mode Version",
      "type": "string"
    },
    "mutates_permanent_core": {
      "const": false,
      "default": false,
      "title": "Mutates Permanent Core",
      "type": "boolean"
    },
    "name": {
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "prohibited_implicit_capabilities": {
      "default": [
        "dependencies",
        "hooks",
        "mcp",
        "network",
        "plugins",
        "scripts",
        "tools"
      ],
      "items": {
        "maxLength": 200,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
        "type": "string"
      },
      "title": "Prohibited Implicit Capabilities",
      "type": "array"
    },
    "publisher": {
      "minLength": 1,
      "title": "Publisher",
      "type": "string"
    },
    "requested_tools": {
      "default": [],
      "items": {
        "maxLength": 200,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
        "type": "string"
      },
      "title": "Requested Tools",
      "type": "array"
    },
    "required_capabilities": {
      "default": [],
      "items": {
        "maxLength": 200,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
        "type": "string"
      },
      "title": "Required Capabilities",
      "type": "array"
    },
    "security_posture": {
      "$ref": "#/$defs/ModeSecurityPosture",
      "default": {
        "dependency_installation": "forbidden",
        "executable_content": "forbidden",
        "mcp_configuration": "forbidden",
        "network_access": "not_requested",
        "plugin_installation": "forbidden",
        "tool_installation": "forbidden"
      }
    },
    "source_kind": {
      "default": "first_party",
      "enum": [
        "curated",
        "first_party",
        "imported"
      ],
      "title": "Source Kind",
      "type": "string"
    },
    "source_license": {
      "minLength": 1,
      "title": "Source License",
      "type": "string"
    },
    "source_revision": {
      "minLength": 1,
      "title": "Source Revision",
      "type": "string"
    },
    "summary": {
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    },
    "supports_personal_overlay": {
      "const": true,
      "default": true,
      "title": "Supports Personal Overlay",
      "type": "boolean"
    },
    "target_compatibility": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ModeTargetCompatibility"
      },
      "title": "Target Compatibility",
      "type": "array"
    },
    "task_lease_hours": {
      "default": 4,
      "maximum": 24,
      "minimum": 1,
      "title": "Task Lease Hours",
      "type": "integer"
    }
  },
  "required": [
    "mode_id",
    "mode_version",
    "name",
    "summary",
    "publisher",
    "source_revision",
    "source_license",
    "applicable_task_classes",
    "compatible_target_families",
    "clauses",
    "maximum_projection_utf8_bytes"
  ],
  "title": "CapabilityMode",
  "type": "object"
}
