{
  "additionalProperties": false,
  "description": "Path-free identity for one project contained in the encrypted bundle.",
  "properties": {
    "capture_after_epoch_seconds": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Capture After Epoch Seconds"
    },
    "display_name": {
      "minLength": 1,
      "title": "Display Name",
      "type": "string"
    },
    "project_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Project Id",
      "type": "string"
    },
    "source_project_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Source Project Digest",
      "type": "string"
    }
  },
  "required": [
    "project_id",
    "display_name",
    "source_project_digest"
  ],
  "title": "RecoveryProjectV1",
  "type": "object"
}
