{
  "additionalProperties": false,
  "description": "Opaque renderer-safe validation of one new local project root.",
  "properties": {
    "display_name": {
      "minLength": 1,
      "title": "Display Name",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "path_exposed": {
      "const": false,
      "default": false,
      "title": "Path Exposed",
      "type": "boolean"
    },
    "preview_token": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Preview Token",
      "type": "string"
    },
    "project_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Project Id",
      "type": "string"
    },
    "selection_token": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Selection Token",
      "type": "string"
    }
  },
  "required": [
    "selection_token",
    "preview_token",
    "project_id",
    "display_name",
    "expires_at"
  ],
  "title": "RecoveryProjectSelectionV1",
  "type": "object"
}
