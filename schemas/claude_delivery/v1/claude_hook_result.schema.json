{
  "$defs": {
    "ClaudeHookAuditReceiptV1": {
      "additionalProperties": false,
      "description": "Signed raw-free audit entry; session and content are represented only by digests.",
      "properties": {
        "content_digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Digest"
        },
        "disposition": {
          "$ref": "#/$defs/ClaudeHookDisposition"
        },
        "event": {
          "$ref": "#/$defs/ClaudeHookEvent"
        },
        "invocation_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Invocation Digest",
          "type": "string"
        },
        "occurred_at": {
          "format": "date-time",
          "title": "Occurred At",
          "type": "string"
        },
        "project_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Project Id",
          "type": "string"
        },
        "projection_lease_digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Projection Lease Digest"
        },
        "receipt_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Receipt Id",
          "type": "string"
        },
        "receipt_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Receipt Version",
          "type": "string"
        },
        "session_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Session Digest",
          "type": "string"
        },
        "signature": {
          "$ref": "#/$defs/SignatureEnvelope"
        },
        "subject_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Subject Id",
          "type": "string"
        }
      },
      "required": [
        "receipt_id",
        "subject_id",
        "project_id",
        "event",
        "disposition",
        "session_digest",
        "invocation_digest",
        "occurred_at",
        "signature"
      ],
      "title": "ClaudeHookAuditReceiptV1",
      "type": "object"
    },
    "ClaudeHookDisposition": {
      "description": "Raw-free outcome of one hook invocation.",
      "enum": [
        "noop_unregistered",
        "noop_unauthorized",
        "noop_no_projection",
        "noop_invalid_projection",
        "delivered",
        "outcome_captured",
        "failure_captured",
        "session_closed"
      ],
      "title": "ClaudeHookDisposition",
      "type": "string"
    },
    "ClaudeHookEvent": {
      "description": "Lifecycle events used by Temper's official Claude Code hook integration.",
      "enum": [
        "UserPromptSubmit",
        "Stop",
        "StopFailure",
        "SessionEnd"
      ],
      "title": "ClaudeHookEvent",
      "type": "string"
    },
    "ClaudeHookSpecificOutputV1": {
      "additionalProperties": false,
      "description": "Official structured UserPromptSubmit response shape.",
      "properties": {
        "additional_context": {
          "maxLength": 10000,
          "minLength": 1,
          "title": "Additional Context",
          "type": "string"
        },
        "hook_event_name": {
          "const": "UserPromptSubmit",
          "default": "UserPromptSubmit",
          "title": "Hook Event Name",
          "type": "string"
        }
      },
      "required": [
        "additional_context"
      ],
      "title": "ClaudeHookSpecificOutputV1",
      "type": "object"
    },
    "ClaudeUserPromptHookOutputV1": {
      "additionalProperties": false,
      "description": "Only output Temper ever returns to Claude Code.",
      "properties": {
        "hook_specific_output": {
          "$ref": "#/$defs/ClaudeHookSpecificOutputV1"
        }
      },
      "required": [
        "hook_specific_output"
      ],
      "title": "ClaudeUserPromptHookOutputV1",
      "type": "object"
    },
    "SignatureEnvelope": {
      "additionalProperties": false,
      "description": "Detached Ed25519 signature metadata included in a signed object.",
      "properties": {
        "algorithm": {
          "const": "Ed25519",
          "default": "Ed25519",
          "title": "Algorithm",
          "type": "string"
        },
        "canonicalization_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Canonicalization Version",
          "type": "string"
        },
        "key_fingerprint": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Key Fingerprint",
          "type": "string"
        },
        "purpose": {
          "minLength": 1,
          "title": "Purpose",
          "type": "string"
        },
        "signature_base64": {
          "minLength": 1,
          "title": "Signature Base64",
          "type": "string"
        },
        "signed_at": {
          "format": "date-time",
          "title": "Signed At",
          "type": "string"
        },
        "signer_identity_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Signer Identity Id",
          "type": "string"
        }
      },
      "required": [
        "signer_identity_id",
        "key_fingerprint",
        "purpose",
        "signed_at",
        "signature_base64"
      ],
      "title": "SignatureEnvelope",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Broker result; an absent output means Claude Code receives a silent exit-0 no-op.",
  "properties": {
    "audit_receipt": {
      "anyOf": [
        {
          "$ref": "#/$defs/ClaudeHookAuditReceiptV1"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "disposition": {
      "$ref": "#/$defs/ClaudeHookDisposition"
    },
    "event": {
      "$ref": "#/$defs/ClaudeHookEvent"
    },
    "output": {
      "anyOf": [
        {
          "$ref": "#/$defs/ClaudeUserPromptHookOutputV1"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "event",
    "disposition"
  ],
  "title": "ClaudeHookResultV1",
  "type": "object"
}
