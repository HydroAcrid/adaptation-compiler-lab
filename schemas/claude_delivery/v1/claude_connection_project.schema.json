{
  "additionalProperties": false,
  "description": "One exact registered project authorized for the local Claude hook.",
  "properties": {
    "project_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Project Id",
      "type": "string"
    },
    "project_registration_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Project Registration Digest",
      "type": "string"
    }
  },
  "required": [
    "project_id",
    "project_registration_digest"
  ],
  "title": "ClaudeConnectionProjectV1",
  "type": "object"
}
