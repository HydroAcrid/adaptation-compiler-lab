{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Temper",
  "version": "0.3.0-alpha.1",
  "identifier": "com.hydroacrid.temper",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:4173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Temper",
        "width": 880,
        "height": 640,
        "minWidth": 720,
        "minHeight": 540,
        "resizable": true,
        "fullscreen": false,
        "devtools": false
      }
    ],
    "security": {
      "capabilities": ["main"],
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; font-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.png"],
    "targets": "all",
    "createUpdaterArtifacts": false,
    "windows": {
      "webviewInstallMode": {
        "type": "skip"
      }
    }
  }
}
