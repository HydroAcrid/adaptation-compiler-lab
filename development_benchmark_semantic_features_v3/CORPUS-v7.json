int":"current_context"},"split":"holdout","tags":["current_context","feature_holdout","indirect","prompt_rule"],"text":"Atlas license headers must be present in distributed source files."},{"case_id":"feature-c86e469ce0f06ffeed68","expectation":{"accepted_routes":["preference"],"accepted_signal_kinds":["preference"],"durable_signal":true,"scope_hint":"permanent_profile"},"split":"holdout","tags":["contrastive","feature_holdout","permanent_profile","preference"],"text":"I’d lean toward smaller database migrations when possible."},{"case_id":"feature-cc547749feb074529cb1","expectation":{"accepted_routes":["procedure"],"accepted_signal_kinds":["procedure"],"durable_signal":true,"scope_hint":"permanent_profile"},"split":"holdout","tags":["emphatic","feature_holdout","permanent_profile","procedure"],"text":"When handing off a task, first summarize the current state, then include the next command to run."},{"case_id":"feature-cffa706f4d27acb8c9ee","expectation":{"accepted_routes":["memory"],"accepted_signal_kinds":["memory"],"durable_signal":true,"scope_hint":"permanent_profile"},"split":"holdout","tags":["direct","feature_holdout","memory","permanent_profile"],"text":"I work with API responses that are consumed by clients maintained by different teams."},{"case_id":"feature-d04a74069cc1b9a6e794","expectation":{"accepted_routes":["example"],"accepted_signal_kinds":["positive_example"],"durable_signal":true,"scope_hint":"current_context"},"split":"holdout","tags":["current_context","feature_holdout","indirect","positive_example"],"text":"The package names in the last approved Atlas change are a good example to follow."},{"case_id":"feature-d1a7be73ccec603dcad5","expectation":{"accepted_routes":["example"],"accepted_signal_kinds":["positive_example"],"durable_signal":true,"scope_hint":"current_context"},"split":"holdout","tags":["current_context","feature_holdout","positive_example","typos"],"text":"The network retry wording from the last change looks good, please use that 