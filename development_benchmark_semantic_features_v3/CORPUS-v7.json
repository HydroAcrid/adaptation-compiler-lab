emphatic","feature_holdout","permanent_profile","revocation"],"text":"Please remove artifact-8b2f403b5395a5d5 from active review-assignment guidance."},{"case_id":"feature-edebcce402797e08d3bc","expectation":{"accepted_routes":["memory"],"accepted_signal_kinds":["memory"],"durable_signal":true,"scope_hint":"permanent_profile"},"split":"holdout","tags":["ambiguous","direct","feature_holdout","permanent_profile"],"text":"I’ve handled support handoffs across several teams. I’d prefer a brief handoff summary."},{"case_id":"feature-f58c6121337891b149ef","expectation":{"accepted_routes":["procedure"],"accepted_signal_kinds":["procedure"],"durable_signal":true,"scope_hint":"current_context"},"split":"holdout","tags":["ambiguous","current_context","feature_holdout","indirect"],"text":"When an Atlas tool is requested, check the allowlist first and then run the approved tool. Unlisted tools must be blocked."},{"case_id":"feature-f988421296fabc02dd48","expectation":{"accepted_routes":[],"accepted_signal_kinds":["revocation"],"affected_artifact_id":"artifact-226485e20a9aa478","durable_signal":true,"scope_hint":"permanent_profile"},"split":"holdout","tags":["direct","feature_holdout","permanent_profile","revocation"],"text":"Remove artifact-226485e20a9aa478 from active preview-output guidance."},{"case_id":"feature-ff8066dad8d95caf1c87","expectation":{"accepted_routes":[],"accepted_signal_kinds":["revocation"],"affected_artifact_id":"artifact-8c2b6f7344d081f7","durable_signal":true,"scope_hint":"current_context"},"split":"holdout","tags":["current_context","feature_holdout","revocation","typos"],"text":"For Atlas release tags, remove artifact-8c2b6f7344d081f7 from active use plese."},{"case_id":"feature-ffe2bea4fb7a8428ed11","expectation":{"accepted_routes":[],"accepted_signal_kinds":["revocation"],"affected_artifact_id":"artifact-4cfdf37064dd2f20","durable_signal":true,"scope_hint":"permanent_profile"},"split":"holdout","tags":["feature_holdout","fragment","permanent_profile","